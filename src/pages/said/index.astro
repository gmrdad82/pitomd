---
import SaidLayout from "../../layouts/SaidLayout.astro";
import SaidPlaceholder from "../../components/SaidPlaceholder.astro";
---

<SaidLayout
  title="Said by PITO — the personal kanban that keeps its word"
  description="Your markdown notes become projects, boards, and cards — local, keyboard-first, with an AI teammate that signs its work. Said and Done."
>
  <header class="said-hero said-wrap">
    <img
      class="said-mark said-mark-hero said-rise"
      src="/said/icon.svg"
      alt="The Said mark — three spoken lines, the last one answered with a check"
    />
    <div class="said-eyebrow said-rise">
      Said by <span class="said-brand">PITO</span>
    </div>
    <h1 class="said-rise said-rise-2">Said<span class="dot">.</span></h1>
    <p class="said-hero-sub said-rise said-rise-3">
      The personal kanban that lives where your notes live. One desk, your own
      machine, and every word kept.
    </p>
    <div class="said-tagline said-rise said-rise-3">
      <span class="t-said">Said</span>
      <span class="t-and">and</span>
      <span class="t-done">Done.</span>
    </div>
    <div class="said-cta-row said-rise said-rise-4">
      <a class="said-btn said-btn-primary" href="/said/tour/">Take the tour</a>
      <a class="said-btn said-btn-ghost" href="/said/guides/">Read the guides</a
      >
    </div>
    <div class="said-visual said-rise said-rise-4">
      <SaidPlaceholder label="Hero loop — the desk in motion" ratio="21 / 9" />
    </div>
  </header>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">01 · The notes are the plan</p>
      <h2>Your notes are already the plan.</h2>
      <p>
        Point Said at the folder where your thinking lives. Every folder inside
        becomes a project with its own boards; nothing is copied, nothing is
        moved. Cards reference the exact lines in your markdown that they came
        from — the plan and the work never drift apart.
      </p>
      <div class="said-visual">
        <SaidPlaceholder label="Folder → projects → boards" />
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">02 · Two faces</p>
      <h2>Two faces. One desk.</h2>
      <p>
        The board carries cards across lanes when you are deciding. The dossier
        reads the same cards as one running record when you are understanding.
        Open any card as a case file: its whole life — every move, every word,
        every reopen — on one sheet.
      </p>
      <div class="said-duo">
        <div>
          <SaidPlaceholder label="The board — living lanes" ratio="4 / 3" />
          <p class="said-tilelabel">
            <strong>The board.</strong> Lanes carry the cards until they land in done.
          </p>
        </div>
        <div>
          <SaidPlaceholder label="The dossier — falling record" ratio="4 / 3" />
          <p class="said-tilelabel">
            <strong>The dossier.</strong> One record, the freshest word on top.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">03 · A named teammate</p>
      <h2>A teammate that signs its work.</h2>
      <p>
        Claude sits at the same desk through its own door. It reads your boards,
        searches your notes, files cards, and leaves comments — every move
        signed with its own name in the history. Never anonymous, never touching
        a thing you didn't ask it to.
      </p>
      <div class="said-visual">
        <SaidPlaceholder label="The thread — owner and claude, named" />
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">04 · Yours</p>
      <h2>Yours, on your machine.</h2>
      <p>
        One local database, daily backups, search that understands meaning —
        running on your own GPU, not somebody's cloud. Your notes stay files,
        your data stays home, and the only copy that matters is yours.
      </p>
      <div class="said-visual">
        <SaidPlaceholder label="Local store · daily backups · GPU search" />
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">05 · Said and Done</p>
      <h2>Say it. Then see it done.</h2>
      <p>
        Said is in release-candidate season. The installers — Linux, macOS,
        Windows, everything bundled, nothing to fetch — are almost ready to
        shake hands.
      </p>
      <div class="said-cta-row">
        <a class="said-btn said-btn-primary" href="/said/tour/"
          >See every feature</a
        >
        <a class="said-btn said-btn-ghost" href="/said/blog/">Read the blog</a>
      </div>
    </div>
  </section>
</SaidLayout>
