---
import SaidLayout from "../../../layouts/SaidLayout.astro";

const guides = [
  {
    href: "/said/guides/first-boot/",
    title: "First boot, first board",
    blurb:
      "Install Said, point it at your notes, pick its face, and land on a working board — in about three minutes.",
  },
  {
    href: "/said/guides/the-keyboard/",
    title: "The keyboard is the desk",
    blurb:
      "Every flow without the mouse: moving between cards, opening them, filing them, finding them.",
  },
  {
    href: "/said/guides/claude-at-the-desk/",
    title: "Let Claude in",
    blurb:
      "Connect a Claude session to your desk over MCP and watch it file its own work under its own name.",
  },
];
---

<SaidLayout
  title="Guides — Said by PITO"
  description="Step-by-step guides for Said: first boot, the keyboard, and connecting Claude to your desk."
  active="guides"
>
  <div class="said-list">
    <header class="said-list-head">
      <div class="said-eyebrow">Guides</div>
      <h1>Shown, step by step.</h1>
      <p>
        Each guide walks one feature from cold start to habit. Short, honest,
        and in the order the desk teaches them.
      </p>
    </header>
    {
      guides.map((g) => (
        <a class="said-entry" href={g.href}>
          <h2>{g.title}</h2>
          <p>{g.blurb}</p>
        </a>
      ))
    }
  </div>
</SaidLayout>
