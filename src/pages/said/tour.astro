---
import SaidShot from "../../components/SaidShot.astro";
import SaidLayout from "../../layouts/SaidLayout.astro";
import SaidPlaceholder from "../../components/SaidPlaceholder.astro";
---

<SaidLayout
  title="The tour — Said"
  description="Nine reasons Said earns a place on your desk: all local, yours forever, on-device AI, MCP-ready, automatic references, two faces, GPU-fast meaning search, every OS, and a remote client."
  active="tour"
>
  <header class="said-hero" style="min-height: 62svh;">
    <canvas class="fx-aurora" aria-hidden="true"></canvas>
    <div class="said-eyebrow said-rise">The tour</div>
    <h1
      class="said-rise said-rise-2"
      style="font-size: clamp(2.8rem, 8vw, 6.5rem);"
    >
      Every feature,<br />plainly said<span class="dot">.</span>
    </h1>
    <p class="said-hero-sub said-rise said-rise-3">
      Nine things Said does, in the order they matter.
    </p>
    <div class="said-cta-row said-rise said-rise-4">
      <a class="said-btn said-btn-primary" href="/said/download/">Download</a>
      <a class="said-btn said-btn-ghost" href="/said/buy-now/"
        >Unlock everything — 4.99€</a
      >
    </div>
  </header>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">01 · All local</p>
      <h2>Everything happens on your machine<span class="dot">.</span></h2>
      <p class="said-note">
        One local database, your notes read in place, nothing sent anywhere to
        make any feature work. No account, no cloud, no sync service between you
        and your own plans.
      </p>
      <SaidShot
        src="/said/shots/board.png"
        alt="The Said board — four lanes carrying real cards, entirely local"
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">02 · Forever yours</p>
      <h2>
        Free forever<span class="dot">.</span> Unlocked for 4<span class="dot"
          >.</span
        >99€<span class="dot">.</span>
      </h2>
      <p class="said-note">
        The free desk runs on as many devices as you own*. One 4.99€ licence
        unlocks unlimited everything on two devices** — pay once, keep it, no
        subscription.
      </p>
      <div class="said-tiers">
        <div class="said-tier-card">
          <h3>Free</h3>
          <ul>
            <li>The whole desk — board, dossier, search, backups</li>
            <li>Unlimited devices</li>
            <li>Up to 5 projects, 10 boards, 100 cards</li>
          </ul>
        </div>
        <div class="said-tier-card is-paid">
          <h3>Licensed · 4.99€</h3>
          <ul>
            <li>Everything in Free</li>
            <li>Unlimited projects, boards, files, references, topics</li>
            <li>One payment, yours forever, updates included</li>
          </ul>
        </div>
      </div>
      <p class="said-note">
        *Free: every feature, capped at 5 projects, 10 boards, and 100 cards.
        **Licensed: no caps anywhere, one key covers 2 devices, moved freely.
      </p>
      <div class="said-cta-row" style="margin-top: 22px;">
        <a class="said-btn said-btn-primary" href="/said/buy-now/"
          >Get the licence</a
        >
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">03 · Local AI</p>
      <h2>AI that lives in the box<span class="dot">.</span></h2>
      <p class="said-note">
        An on-device embedding model indexes your markdown as you write it —
        smart matching between what you type and what you meant, computed at
        home, sent nowhere.
      </p>
      <SaidShot
        src="/said/shots/finder.png"
        alt="The finder — an exact hit on top, meaning matches beneath it"
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">04 · AI-ready</p>
      <h2>
        Speaks MCP<span class="dot">.</span> Works with your agents<span
          class="dot">.</span>
      </h2>
      <p class="said-note">
        Any MCP client can sit at your desk: list boards, search notes, file and
        move cards, speak in threads. Every action signed with the agent's own
        name, exactly like yours.
      </p>
      <SaidShot
        src="/said/shots/casefile.png"
        alt="A case file where an agent reports its fix under its own name"
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">05 · References</p>
      <h2>It remembers where every thought lives<span class="dot">.</span></h2>
      <p class="said-note">
        Cards point at the exact lines of the markdown they came from —
        suggested automatically at birth, readable in place, tracked as your
        files change. The board never drifts from the thinking behind it.
      </p>
      <div class="said-duo">
        <div>
          <SaidShot
            src="/said/shots/card.png"
            alt="A card with its file references and line ranges"
            class="said-reveal said-zoom"
          />
        </div>
        <div>
          <SaidShot
            src="/said/shots/reference.png"
            alt="A reference read in place — the exact markdown lines, rendered"
            class="said-reveal said-zoom"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">06 · Two faces</p>
      <h2>
        Kanban when deciding<span class="dot">.</span> Dossier when understanding<span
          class="dot">.</span>
      </h2>
      <p class="said-note">
        The board carries cards across lanes. The dossier reads the same cards
        as one running record, with an index drawer and per-card case files.
        Pick your face at first boot; change it any time.
      </p>
      <div class="said-duo">
        <div>
          <SaidShot
            src="/said/shots/dossier.png"
            alt="The dossier — one running record of every card"
            class="said-reveal said-zoom"
          />
        </div>
        <div>
          <SaidShot
            src="/said/shots/wizard-face.png"
            alt="First boot asking which face the desk should wear"
            class="said-reveal said-zoom"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">07 · GPU fast</p>
      <h2>Meaning search at GPU speed<span class="dot">.</span></h2>
      <p class="said-note">
        The embedding engine rides your graphics card — indexing in the
        background, answering in milliseconds, never blocking a keystroke.
        Blazing on a gaming rig, quiet on a laptop.
      </p>
      <SaidShot
        src="/said/shots/projects.png"
        alt="The project switcher answering instantly"
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">08 · Every OS</p>
      <h2>
        Linux, macOS, Windows<span class="dot">.</span> One installer each<span
          class="dot">.</span>
      </h2>
      <p class="said-note">
        Native installers with everything bundled — the engine, the tools, the
        desk. Nothing downloads at boot; uninstalling never touches your data or
        your notes.
      </p>
      <div class="said-cta-row" style="margin-top: 26px;">
        <a class="said-btn said-btn-ghost" href="/said/download/"
          >See the installers</a
        >
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">09 · Remote</p>
      <h2>The desk in your pocket<span class="dot">.</span></h2>
      <p class="said-note">
        A packed-in remote client rides the same desk from your phone, through
        your own tunnel, with one token. The window closed means the remote is
        off — no daemon, no surprise surface.
      </p>
      <div class="said-visual" style="max-width: 420px; margin-inline: auto;">
        <SaidPlaceholder
          label="Capture coming — the remote client, mobile"
          ratio="9 / 16"
        />
      </div>
      <div class="said-cta-row" style="margin-top: 40px;">
        <a class="said-btn said-btn-primary" href="/said/buy-now/"
          >Unlock everything — 4.99€</a
        >
        <a class="said-btn said-btn-ghost" href="/said/guides/"
          >Read the guides</a
        >
      </div>
    </div>
  </section>
</SaidLayout>
