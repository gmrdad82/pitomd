---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ColorBridge from "../components/ColorBridge.astro";
import PitoLogo from "../components/PitoLogo.astro";

// pitomd.com — the over-the-top, scroll-driven PITO showcase. One long page,
// a distinct theme + font + entrance per section, fx ported (in spirit) from
// pito. Sells and wows; every "how/where" resolves to GitHub. Copy is pito's
// house voice (dry, witty), much of it adapted from the app's own strings.

const GITHUB = "https://github.com/gmrdad82/pito";
const SPONSOR = "https://github.com/sponsors/gmrdad82";
const YOUTUBE = "https://www.youtube.com/@gmrdad82";
const INSTALL = "curl -fsSL pitomd.com/install.sh | sh";

const avatars = [
  { file: "@gmrdad82.png", name: "Gamer Dad" },
  { file: "@gmrdad82good.png", name: "The Good" },
  { file: "@gmrdad82hard.png", name: "The Hard" },
  { file: "@gmrdad82fighter.png", name: "The Fighter" },
  { file: "@gmrdad82strategist.png", name: "The Strategist" },
  { file: "@gmrdad82survivor.png", name: "The Survivor" },
];
---

<Base>
  {/* ── 1 · HERO ─────────────────────────────────────────── */}
  <Section id="hero" theme="synthwave" label="Start" class="hero f-grotesk">
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--react logo-accent--sm logo-accent--cyan" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--bl logo-accent--float logo-accent--sm logo-accent--purple" />
    <div class="hero__stack">
      <img
        class="hero__logo"
        src="/logo/pito-logo-hero.png"
        width="4140"
        height="1393"
        alt="PITO"
        fetchpriority="high"
        data-reveal="zoom"
      />
      <p class="eyebrow" data-reveal="fade">the best YouTube tool</p>
      <h1 class="display hero__title">
        <span data-fx="typewriter" data-fx-speed="55">one chatbox.</span><br />
        <span class="pito-blue" data-fx="typewriter" data-fx-speed="55">every channel.</span>
      </h1>
      <p class="lede hero__lede" data-reveal="rise">
        A self-hosted command deck for the multi-channel creator. Type plain
        English, it answers. No tabs, no logging out, no $50-a-month ransom.
      </p>
      <div class="hero__cta" data-reveal="rise">
        <a class="btn btn--primary" href={GITHUB} data-magnetic>Get it on GitHub →</a>
        <a class="btn btn--ghost" href={YOUTUBE}>▶ Watch the tour</a>
      </div>
      <div
        class="copybox"
        data-copy={INSTALL}
        data-reveal="fade"
        title="Click to copy"
      >
        <span class="copybox__prompt mono">$</span>
        <code class="copybox__cmd mono" data-fx="comet">{INSTALL}</code>
        <button type="button" class="copybox__btn mono" data-copy-btn aria-label="Copy install command">
          <span data-copy-label>⧉ copy</span>
        </button>
      </div>
    </div>
  </Section>

  {/* ── 2 · THE PAIN ─────────────────────────────────────── */}
  <Section id="pain" theme="dracula" label="The pain" class="f-heavy">
    <img slot="decor" class="logo-accent logo-accent--watermark" src="/logo/pito-wordmark-white.png" alt="" aria-hidden="true" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--sm logo-accent--react logo-accent--strong logo-accent--orange" />
    <p class="eyebrow" data-reveal="fade">If this is you</p>
    <h2 class="display" data-fx="scramble" data-reveal="skew">
      Log out. Log in. Repeat. Forever.
    </h2>
    <div class="prose" data-reveal="rise">
      <p>
        YouTube Studio, in its infinite wisdom, manages exactly
        <span class="accent">one channel at a time</span>. Run a handful and your
        day becomes a carousel of sign-outs and sign-ins until your will to live
        quietly files for unemployment.
      </p>
      <p>
        The paid tools? Social Blade, vidIQ, TubeBuddy — tried them, paid them,
        and not one did the specific things a real multi-channel creator needs.
        They'd love <span class="accent">$50+ a month</span>, please, forever,
        amen, for the privilege of <em>almost</em> fitting.
      </p>
    </div>
  </Section>

  {/* ── 3 · ONE CHATBOX ──────────────────────────────────── */}
  <Section id="chatbox" theme="tokyo-night" label="One chatbox" class="f-funk">
    <PitoLogo slot="decor" class="logo-accent logo-accent--tl logo-accent--float logo-accent--cyan" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--br logo-accent--sm logo-accent--react" />
    <div class="split">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">One box to rule them all</p>
        <h2 class="display" data-fx="comet">Type. It answers.</h2>
        <p class="lede" data-reveal="rise">
          No dashboards to learn, no menus to hunt. A single chatbox that speaks
          every one of your channels — see subs · vids · views for all of them in
          one <code class="kbd">list channels</code>.
        </p>
      </div>
      <figure class="split__media" data-reveal="right" data-tilt data-parallax="slow">
        <img src="/media/01-chat.gif" width="760" alt="The PITO chatbox in action" loading="lazy" />
      </figure>
    </div>
  </Section>

  {/* ── 4 · PLAIN LANGUAGE ───────────────────────────────── */}
  <Section id="language" theme="nord" label="Plain language" class="f-mono">
    <PitoLogo slot="decor" class="logo-accent logo-accent--br logo-accent--react" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--tl logo-accent--float logo-accent--green logo-accent--sm" />
    <div class="split split--reverse">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">No syntax to memorize</p>
        <h2 class="display" data-reveal="crash">Just say what you want.</h2>
        <p class="lede" data-reveal="rise">
          <code class="kbd">list vids</code>. <code class="kbd">show game 42</code>.
          <code class="kbd">list games rpg ps5</code> filters by genre and
          platform — natural-ish, case-insensitive. PITO speaks human.
        </p>
      </div>
      <figure class="split__media" data-reveal="left" data-tilt data-parallax="slow">
        <img src="/media/02-language.gif" width="760" alt="Plain-language commands in PITO" loading="lazy" />
      </figure>
    </div>
  </Section>

  {/* ── 5 · LINKAGE ──────────────────────────────────────── */}
  <Section id="linkage" theme="gruvbox-dark" label="Linkage" class="f-grotesk">
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--react" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--bl logo-accent--float logo-accent--sm logo-accent--orange" />
    <img slot="decor" src="/coin/coin.gif" class="pixel-accent pixel-accent--spin" style="top:14%;right:9%;width:120px;height:90px;opacity:.5" alt="" aria-hidden="true" />
    <div class="split">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">You tell it, it remembers</p>
        <h2 class="display" data-reveal="rise">Games ↔ videos ↔ channels.</h2>
        <p class="lede" data-reveal="rise">
          <code class="kbd">import game</code> grabs genres, themes, devs,
          release, and price from IGDB. <code class="kbd">link</code> ties a video
          to a game — <span class="accent">PITO never guesses from titles, you
          tell it.</span>
        </p>
      </div>
      <figure class="split__media" data-reveal="right" data-tilt data-parallax="slow">
        <img src="/media/03-linkage.gif" width="760" alt="Game-to-video linkage in PITO" loading="lazy" />
      </figure>
    </div>
  </Section>

  {/* ── COLOR BRIDGE → Voyage ─────────────────────────────── */}
  <ColorBridge
    letter="V"
    color="#5170ff"
    ink="#0a0a12"
    text="Voyage"
    sub="game ↔ channel. both ways."
  />

  {/* ── 6 · VOYAGE — pinned scrollytelling ───────────────── */}
  <section
    id="voyage"
    class="scrolly"
    data-theme="synthwave"
    data-nav-label="Voyage"
    data-scrolly
    style="--steps: 6"
  >
    <div class="scrolly__stage">
      <span class="scrolly__hint">Voyage · scroll through</span>
      <div class="scrolly__steps">
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big">You played a game.</h2>
          <p class="scrolly__sub">
            Tell PITO once. It pulls genres, themes, devs, release, and price from
            IGDB — the game becomes a first-class thing it can reason about.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <p class="scrolly__arrow">game →</p>
          <h2 class="scrolly__big pito-blue">the channels it fits.</h2>
          <p class="scrolly__sub">
            Every game card surfaces the channels it pairs well with. Stop
            guessing where the footage belongs.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big">You run a channel.</h2>
          <p class="scrolly__sub">A channel is its videos. PITO already knows what you cover.</p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <p class="scrolly__arrow">channel →</p>
          <h2 class="scrolly__big pito-blue">the games that suit it.</h2>
          <p class="scrolly__sub">
            The channel-specific picks are computed from the games you've covered —
            <span class="accent">no guesswork, no vibes.</span>
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big">Similar games, surfaced.</h2>
          <p class="scrolly__sub">
            Curious what to play next? Voyage keeps fresh similar-games picks warm
            in the background.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big">It runs on <span class="pito-blue">Voyage</span> embeddings.</h2>
          <p class="scrolly__sub">
            The more you publish, the sharper it gets — recommendations recomputed
            over time from everything you cover.
          </p>
        </div>
      </div>
      <span class="scrolly__counter" data-scrolly-progress>01 / 06</span>
    </div>
  </section>

  {/* ── 7 · FOOTAGE ──────────────────────────────────────── */}
  <Section id="footage" theme="ayu-dark" label="Footage" class="f-round">
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--react logo-accent--strong" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--bl logo-accent--float logo-accent--cyan logo-accent--sm" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--tl logo-accent--float logo-accent--sm" />
    <p class="eyebrow" data-reveal="fade">Time is the real budget</p>
    <h2 class="display" data-fx="comet">Track the footage.</h2>
    <p class="lede" data-reveal="rise" style="margin-inline:auto;max-width:42rem">
      Recorded-but-unpublished hours per game, kept as a manual
      <code class="kbd">footage</code> total, plotted against the game's
      time-to-beat. The time you've sunk is an investment — PITO makes it visible.
    </p>
    {/* Real Pito::TimeToBeatComponent — heat-mapped fuel gauge with the footage
        tick, rendered from pito. Per-game adaptive gradient (inline). */}
    <div class="pito-widget" data-reveal="rise" data-tilt>
      <div class="pito-ttb" data-component="time-to-beat">
        <span class="pito-ttb__label">Time spend</span>
        <div class="pito-ttb__body">
          <div class="pito-ttb__values pito-ttb__values--top">
            <div class="pito-ttb__footage-bubble ttb-label--at-start" data-accent="footage" style="left: 8.75%;">
              <span class="pito-ttb__footage-bubble-num">12h</span>
              <span class="pito-ttb__footage-bubble-arrow">&#9660;</span>
            </div>
          </div>
          <div class="pito-ttb__bar-row">
            <span class="pito-ttb__bar">
              <span class="pito-ttb__track">
                <span class="pito-ttb__bracket">[</span>
                <span class="pito-ttb__fill pito-bar-shimmer pito-shimmer-d10" style="background-image: var(--pito-bar-band, linear-gradient(transparent, transparent)), linear-gradient(to right in oklch, color-mix(in oklch, var(--accent-green) 70%, var(--fg-default)) 0.0%, color-mix(in oklch, color-mix(in oklch, var(--accent-green), var(--accent-yellow)) 58%, var(--fg-default)) 8.06%, color-mix(in oklch, color-mix(in oklch, var(--accent-orange) 60%, var(--accent-yellow)) 58%, var(--fg-default)) 32.26%, color-mix(in oklch, var(--accent-red), var(--accent-purple)) 80.65%, color-mix(in oklch, var(--accent-red), var(--accent-purple)) 100%);"></span>
                <span class="pito-ttb__bracket">]</span>
              </span>
              <span class="pito-ttb__tick ttb-tick--main" data-accent="main" style="left: 26.25%;">|</span>
              <span class="pito-ttb__tick ttb-tick--extras" data-accent="extras" style="left: 56.25%;">|</span>
              <span class="pito-ttb__tick ttb-tick--completionist" data-accent="completionist" style="left: 98.75%;">|</span>
              <span class="pito-ttb__tick ttb-tick--footage" data-accent="footage" style="left: 8.75%;">|</span>
            </span>
          </div>
          <div class="pito-ttb__values pito-ttb__values--bottom">
            <span class="pito-ttb__value pito-ttb__value--pillar ttb-label--centered" data-pillar="main" style="left: 26.25%;">31h</span>
            <span class="pito-ttb__value pito-ttb__value--pillar ttb-label--centered" data-pillar="extras" style="left: 56.25%;">71h</span>
            <span class="pito-ttb__value pito-ttb__value--pillar ttb-label--at-end" data-pillar="completionist" style="left: 98.75%;">124h</span>
          </div>
          <div class="pito-ttb__legend">
            <span class="pito-ttb__legend-item"><span class="pito-ttb__legend-tick" data-accent="main">|</span><span class="pito-ttb__legend-label">main</span></span>
            <span class="pito-ttb__legend-item"><span class="pito-ttb__legend-tick" data-accent="extras">|</span><span class="pito-ttb__legend-label">extras</span></span>
            <span class="pito-ttb__legend-item"><span class="pito-ttb__legend-tick" data-accent="completionist">|</span><span class="pito-ttb__legend-label">completionist</span></span>
            <span class="pito-ttb__legend-item"><span class="pito-ttb__legend-tick" data-accent="footage">|</span><span class="pito-ttb__legend-label">footage</span></span>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ── 8 · PRICE / COINS ────────────────────────────────── */}
  {/* Coin/star glyphs + tier map are pito's exact spec (Pito::Coin):
      ≤9.99→1 · ≤29.99→2 · ≤59.99→3 · ≤79.99→4 · >79.99→5 · free→star. */}
  <Section id="price" theme="gruvbox-dark" label="Price" class="f-funk">
    <PitoLogo slot="decor" class="logo-accent logo-accent--bl logo-accent--float logo-accent--orange" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--react logo-accent--sm" />
    {/* coins gone feral — big, distorted, spinning pixel art */}
    <img slot="decor" src="/coin/coin.gif" class="pixel-accent pixel-accent--spin" style="top:11%;left:6%;width:130px;height:98px;opacity:.6" alt="" aria-hidden="true" />
    <img slot="decor" src="/coin/coin.gif" class="pixel-accent pixel-accent--bob" style="bottom:12%;right:7%;width:190px;height:143px;opacity:.5" alt="" aria-hidden="true" />
    <img slot="decor" src="/coin/coin.gif" class="pixel-accent pixel-accent--squash" style="top:16%;right:13%;width:104px;height:150px;opacity:.4" alt="" aria-hidden="true" />
    <img slot="decor" src="/coin/coin.gif" class="pixel-accent pixel-accent--react" style="bottom:26%;left:12%;width:230px;height:96px;opacity:.45" alt="" aria-hidden="true" />
    <p class="eyebrow" data-reveal="fade">Value per coin</p>
    <h2 class="display" data-reveal="crash">What did it cost you?</h2>
    <p class="lede" data-reveal="rise" style="margin-inline:auto;max-width:42rem">
      <code class="kbd">price set 42 59.99</code> tags a game's cost so you can
      budget your next capture. The coins read how expensive it is at a glance —
      one for budget, five for collector — and the <span class="accent">star</span>
      means genuine free, not cheap-but-paid.
    </p>
    <div class="coins" data-reveal="rise" data-stagger>
      <span class="coin-chip" style="--i:0">
        <span class="glyphs"><img src="/coin/coin.gif" alt="" width="64" height="48" /></span>
        <span class="num">9.99</span>
      </span>
      <span class="coin-chip" style="--i:1">
        <span class="glyphs"><img src="/coin/coin.gif" alt="" width="64" height="48" /><img src="/coin/coin.gif" alt="" width="64" height="48" /><img src="/coin/coin.gif" alt="" width="64" height="48" /></span>
        <span class="num">59.99</span>
      </span>
      <span class="coin-chip" style="--i:2">
        <span class="glyphs"><img src="/coin/coin.gif" alt="" width="64" height="48" /><img src="/coin/coin.gif" alt="" width="64" height="48" /><img src="/coin/coin.gif" alt="" width="64" height="48" /><img src="/coin/coin.gif" alt="" width="64" height="48" /><img src="/coin/coin.gif" alt="" width="64" height="48" /></span>
        <span class="num">89.99</span>
      </span>
      <span class="coin-chip" style="--i:3">
        <span class="glyphs"><img src="/coin/star.gif" alt="" width="49" height="48" /></span>
        <span class="free">FREE</span>
      </span>
    </div>
    <p class="lede" data-reveal="rise" style="margin:2.5rem auto 0;max-width:42rem">
      Cost is half the story — PITO also scores each game (vote-weighted), so you
      read value at a glance: what you paid against how good it actually is.
    </p>
    {/* Real Pito::ScoreBarComponent — red→green heat bar + score bubble. */}
    <div class="pito-widget" data-reveal="rise" data-tilt>
      <span class="pito-score-bar" data-score="81" data-tier="good" data-resyncing="no">
        <span class="pito-score-bar__track">
          <span class="pito-score-bar__bracket">[</span>
          <span class="pito-score-bar__fill pito-bar-shimmer pito-shimmer-d13"></span>
          <span class="pito-score-bar__bracket">]</span>
          <span class="pito-score-bar__bubble pito-score-bar__overlay--centered" data-accent="score" style="left: 81.0%;">
            <span class="pito-score-bar__bubble-num">81</span>
            <span class="pito-score-bar__bubble-arrow">&#9660;</span>
          </span>
          <span class="pito-score-bar__tick pito-score-bar__overlay--centered" data-accent="score" style="left: 81.0%;">|</span>
        </span>
      </span>
    </div>
  </Section>

  {/* ── 9 · SHINIES ──────────────────────────────────────── */}
  <Section id="shinies" theme="synthwave" label="Shinies" class="f-round">
    <PitoLogo slot="decor" class="logo-accent logo-accent--bl logo-accent--float logo-accent--purple" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--react logo-accent--strong logo-accent--cyan logo-accent--sm" />
    {/* stars — shinies, scaled hard and distorted */}
    <img slot="decor" src="/coin/star.gif" class="pixel-accent pixel-accent--spin" style="top:12%;right:7%;width:150px;height:147px;opacity:.65" alt="" aria-hidden="true" />
    <img slot="decor" src="/coin/star.gif" class="pixel-accent pixel-accent--squash" style="bottom:13%;left:7%;width:120px;height:172px;opacity:.5" alt="" aria-hidden="true" />
    <img slot="decor" src="/coin/star.gif" class="pixel-accent pixel-accent--throb" style="top:20%;left:13%;width:92px;height:90px;opacity:.6" alt="" aria-hidden="true" />
    <img slot="decor" src="/coin/star.gif" class="pixel-accent pixel-accent--react pixel-accent--spin-rev" style="bottom:22%;right:15%;width:120px;height:118px;opacity:.5" alt="" aria-hidden="true" />
    <p class="eyebrow" data-reveal="fade">Achievements, but honest</p>
    <h2 class="display" data-reveal="morph">We call them shinies.</h2>
    <p class="lede" data-reveal="rise" style="margin-inline:auto;max-width:42rem">
      They unlock as your subs, views, and watch time grow — a 22-step milestone
      series (1 → 10M) that shimmers up through the tier colours. This is PITO's
      real progress track, live:
    </p>
    {/* Real Pito::Achievement::TrackComponent markup, rendered from pito via
        bin/rails runner. The reached run shimmers in the next tier's colour. */}
    <div class="pito-widget" data-reveal="rise" data-tilt><span class="pito-achievement-track"><span class="pito-achievement-track__label">Subs</span><span class="pito-achievement-track__rail"><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--reached pito-shimmer-d4" data-accent="blue">●</span><span class="pito-achievement-track__value">1</span></span><span class="pito-achievement-track__ellipsis pito-achievement-track__ellipsis--reached pito-shimmer-d1" data-accent="blue">──────────────────────────────···──────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--reached pito-shimmer-d3" data-accent="blue">●</span><span class="pito-achievement-track__value">500</span></span><span class="pito-achievement-track__connector pito-achievement-track__connector--reached pito-shimmer-d13" data-accent="blue">────────────────────────────────────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--reached pito-shimmer-d5" data-accent="blue">◉</span><span class="pito-achievement-track__value">1K</span></span><span class="pito-achievement-track__connector pito-achievement-track__connector--reached pito-shimmer-d11" data-accent="blue">────────────────────────────────────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--upcoming">○</span><span class="pito-achievement-track__value">2K</span></span><span class="pito-achievement-track__ellipsis">──────────────────────────────···──────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--upcoming">○</span><span class="pito-achievement-track__value">10M</span></span></span></span></div>
    <div class="pito-widget" data-reveal="rise" data-tilt><span class="pito-achievement-track"><span class="pito-achievement-track__label">Views</span><span class="pito-achievement-track__rail"><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--reached pito-shimmer-d4" data-accent="orange">●</span><span class="pito-achievement-track__value">1</span></span><span class="pito-achievement-track__ellipsis pito-achievement-track__ellipsis--reached pito-shimmer-d7" data-accent="orange">──────────────────────────────···──────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--reached pito-shimmer-d7" data-accent="orange">●</span><span class="pito-achievement-track__value">100K</span></span><span class="pito-achievement-track__connector pito-achievement-track__connector--reached pito-shimmer-d0" data-accent="orange">────────────────────────────────────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--reached pito-shimmer-d9" data-accent="orange">◉</span><span class="pito-achievement-track__value">200K</span></span><span class="pito-achievement-track__connector pito-achievement-track__connector--reached pito-shimmer-d16" data-accent="orange">────────────────────────────────────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--upcoming">○</span><span class="pito-achievement-track__value">500K</span></span><span class="pito-achievement-track__ellipsis">──────────────────────────────···──────────────────────────────</span><span class="pito-achievement-track__cell"><span class="pito-achievement-track__dot pito-achievement-track__dot--upcoming">○</span><span class="pito-achievement-track__value">10M</span></span></span></span></div>
