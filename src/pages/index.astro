---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ColorBridge from "../components/ColorBridge.astro";
import PitoLogo from "../components/PitoLogo.astro";

// pitomd.com — the over-the-top, scroll-driven PITO showcase. One long page,
// a distinct theme + font + entrance per section, fx ported (in spirit) from
// pito. Sells and wows; every "how/where" resolves to GitHub. Copy is pito's
// house voice (dry, witty), much of it adapted from the app's own strings.

const GITHUB = "https://github.com/gmrdad82/pito";
const ANDROID = "https://github.com/gmrdad82/pito-android";
const TUI = "https://github.com/gmrdad82/pito-tui";
const SPONSOR = "https://github.com/sponsors/gmrdad82";
const YOUTUBE = "https://www.youtube.com/@gmrdad82";
const TOUR_VID = "https://youtu.be/7y3R403XtDE";
const X = "https://x.com/GamerDady82";
const DISCORD = "https://discord.gg/q947UyDTqJ";
const INSTALL = "curl -fsSL pitomd.com/install.sh | sh";

// The one channel — the avatar links to it (per ~/Dev/gmrdad82/README.md).
const YT = "https://www.youtube.com";
const avatars = [
  {
    file: "@gmrdad82.png",
    name: "Gamer Dad - Stories",
    url: `${YT}/@gmrdad82`,
  },
];

// Real game cover art exported from pito (the owner's own catalogue).
const covers = [
  { f: "elden-ring", t: "Elden Ring" },
  { f: "stellar-blade", t: "Stellar Blade" },
  { f: "cyberpunk-2077", t: "Cyberpunk 2077" },
  { f: "nioh-3", t: "Nioh 3" },
  { f: "demon-s-souls", t: "Demon's Souls" },
  { f: "tekken-7", t: "Tekken 7" },
  { f: "pragmata", t: "Pragmata" },
  { f: "elden-ring-nightreign", t: "Elden Ring Nightreign" },
  { f: "stellar-blade-blood-rain", t: "Stellar Blade: Blood Rain" },
  { f: "ghosts-n-goblins-resurrection", t: "Ghosts 'n Goblins Resurrection" },
  { f: "terminator-2d-no-fate", t: "Terminator 2D: No Fate" },
  { f: "pool/hades-ii", t: "Hades II" },
  { f: "pool/lies-of-p", t: "Lies of P" },
  { f: "pool/clair-obscur-expedition-33", t: "Clair Obscur: Expedition 33" },
  { f: "pool/silent-hill-townfall", t: "Silent Hill: Townfall" },
];
const depths = [12, 5, 9, 14, 6, 11, 4, 13, 7, 10, 8, 15, 3, 9, 6];
---

<Base>
  {/* Persistent social rail (left) — hidden on mobile. */}
  <nav class="socialbar" aria-label="Follow Catalin">
    <a href={YOUTUBE} aria-label="YouTube" data-magnetic
      ><img
        decoding="async"
        src="/social/youtube.svg"
        width="20"
        height="20"
        alt=""
      /></a
    >
    <a href={X} aria-label="X" data-magnetic
      ><img
        decoding="async"
        src="/social/x.svg"
        width="17"
        height="17"
        alt=""
      /></a
    >
    <a href={DISCORD} aria-label="Discord" data-magnetic
      ><img
        decoding="async"
        src="/social/discord.svg"
        width="20"
        height="20"
        alt=""
      /></a
    >
  </nav>

  {/* ── 1 · HERO ─────────────────────────────────────────── */}
  <Section id="hero" theme="synthwave" label="Start" class="hero f-grotesk">
    <div
      slot="decor"
      class="cover-bed"
      data-cover-slot="bed"
      style="--cover:url('/covers/stellar-blade.jpg')"
      aria-hidden="true"
    >
    </div>
    <div slot="decor" class="aurora" aria-hidden="true">
      <i class="aurora__blob aurora__blob--blue"></i>
      <i class="aurora__blob aurora__blob--purple"></i>
      <i class="aurora__blob aurora__blob--cyan"></i>
    </div>
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--react logo-accent--sm logo-accent--cyan"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--bl logo-accent--float logo-accent--sm logo-accent--purple"
    />
    <div class="hero__stack">
      <img
        decoding="async"
        class="hero__logo"
        src="/logo/pito-logo-hero.png"
        width="1200"
        height="404"
        alt="PITO"
        fetchpriority="high"
        data-reveal="zoom"
      />
      <p class="eyebrow" data-reveal="fade">the best YouTube tool</p>
      <h1 class="display hero__title">
        <span data-fx="typewriter" data-fx-speed="55">one chatbox.</span><br />
        <span
          class="pito-blue"
          data-fx="typewriter"
          data-fx-speed="55"
          data-fx-delay="900">every channel.</span
        >
      </h1>
      <p class="lede hero__lede" data-reveal="rise">
        A self-hosted command deck for the multi&#8209;channel creator. Type
        plain English, it answers. No tabs, no logging out, no{" "}
        <span class="nowrap"><span data-cur>$</span>50-a-month ransom.</span>
      </p>
      <div class="hero__cta" data-reveal="rise">
        <a class="btn btn--primary" href={GITHUB} data-magnetic
          >Get it on GitHub -></a
        >
        <a class="btn btn--ghost" href={TOUR_VID} data-magnetic
          >▶ Watch the tour</a
        >
      </div>
      <a
        class="hero__tour"
        href={TOUR_VID}
        data-reveal="rise-big"
        data-tilt
        aria-label="Watch the PITO tour"
      >
        <span class="hero__tour-chrome" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="hero__tour-name mono">pito — the guided tour</span>
        </span>
        <img
          decoding="async"
          src="/media/pito-tour-thumb.png"
          width="760"
          alt="▶ PITO — a guided tour"
          loading="lazy"
        />
        <span class="hero__tour-play" aria-hidden="true"
          ><span class="hero__tour-play-glyph">▶</span></span
        >
      </a>
      <div
        class="copybox"
        data-copy={INSTALL}
        data-reveal="fade"
        title="Click to copy"
      >
        <span class="copybox__prompt mono">$</span>
        <code class="copybox__cmd mono" data-fx="comet">{INSTALL}</code>
        <button
          type="button"
          class="copybox__btn mono"
          data-copy-btn
          aria-label="Copy install command"
        >
          <span data-copy-label>⧉ copy</span>
        </button>
      </div>
    </div>
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {
          Array.from({ length: 2 }).map(() => (
            <span class="ticker__seq">
              <span class="ticker__cmd">show game 42</span>
              <span class="ticker__cmd">list vids</span>
              <span class="ticker__cmd">analyze channel</span>
              <span class="ticker__cmd">link 17 42</span>
              <span class="ticker__cmd">price set 42 59.99</span>
              <span class="ticker__cmd">footage update 42 +2.5</span>
              <span class="ticker__cmd">search games for tekken</span>
              <span class="ticker__cmd">schedule 9 slate</span>
              <span class="ticker__cmd">share</span>
              <span class="ticker__cmd">import game inception</span>
              <span class="ticker__cmd">show channel @gmrdad82</span>
              <span class="ticker__cmd">list games rpg</span>
              <span class="ticker__cmd">
                search conversations for tekken combos
              </span>
              <span class="ticker__cmd">sync vids</span>
            </span>
          ))
        }
      </div>
    </div>
  </Section>

  {/* ── 2 · THE PAIN ─────────────────────────────────────── */}
  <Section id="pain" theme="dracula" label="The pain" class="f-heavy">
    <div
      slot="decor"
      class="cover-bed"
      data-cover-slot="bed"
      style="--cover:url('/covers/demon-s-souls.jpg')"
      aria-hidden="true"
    >
    </div>
    {/* Layer A — bg watermark: slow, large parallax */}
    <img
      decoding="async"
      slot="decor"
      class="logo-accent logo-accent--watermark par par--A"
      src="/logo/pito-wordmark-white.png"
      alt=""
      aria-hidden="true"
    />
    {/* Layer B — existing corner accent + two new mid-section accents */}
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--sm logo-accent--react logo-accent--strong logo-accent--orange par par--B"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--mid-l logo-accent--sm logo-accent--purple par par--B"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--low-r logo-accent--sm logo-accent--cyan par par--B"
    />
    <p class="eyebrow" data-reveal="fade">If this is you</p>
    <h2 class="display" data-fx="scramble" data-reveal="skew">
      Log out. Log in. Repeat. Forever.
    </h2>
    <div class="prose" data-reveal="rise">
      <p>
        YouTube Studio, in its infinite wisdom, manages exactly{" "}
        <span class="accent">one channel at a time</span>. Run a handful and
        your day becomes a carousel of sign-outs and sign-ins until your will to
        live quietly files for unemployment.
      </p>
      <p>
        The paid tools? Social Blade, vidIQ, TubeBuddy — tried them, paid them,
        and not one did the specific things a real multi&#8209;channel creator
        needs. They'd love <span class="accent"
          ><span data-cur>$</span>50+ a month</span
        >, please, forever, amen, for the privilege of <em>almost</em> fitting.
      </p>
    </div>
  </Section>

  {/* ── 3 · ONE CHATBOX — plain language, no syntax ──────── */}
  <Section id="chatbox" theme="nord" label="One chatbox" class="f-mono">
    <div
      slot="decor"
      class="cover-bed"
      data-cover-slot="bed"
      style="--cover:url('/covers/nioh-3.jpg')"
      aria-hidden="true"
    >
    </div>
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--br logo-accent--react"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tl logo-accent--float logo-accent--green logo-accent--sm"
    />
    <div class="split">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">One box, no syntax to memorize</p>
        <h2 class="display" data-fx="typewriter" data-fx-speed="45">
          Speak your language.
        </h2>
        <p class="lede" data-reveal="rise">
          One chatbox for every channel — no dashboards, no menus, nothing to
          learn. <code class="kbd">list vids</code>, <code class="kbd"
            >show game 42</code
          >, <code class="kbd">search games like tekken</code>, and <code
            class="kbd">list games rpg</code
          > filters by genre and platform — or skip the syntax and just say what you
          mean. When PITO is sure, it answers and shows you the command it understood,
          so you pick up the fast path as you go; when it isn't, it asks first. Nothing
          runs without being shown.
        </p>
      </div>
      <figure class="split__media" data-reveal="blurin" data-tilt>
        <img
          decoding="async"
          src="/media/mkt-language.gif"
          width="760"
          alt="Plain-language commands in the PITO chatbox"
          loading="lazy"
        />
      </figure>
    </div>
  </Section>

  {/* ── 3.2 · AI — @ai · MCP · local AI, one rail stop ─────── */}
  <section id="ai" data-nav-label="AI">
    <Section id="ai-chat" theme="synthwave" label="" class="f-grotesk">
      <div
        slot="decor"
        class="cover-bed"
        data-cover-slot="bed"
        style="--cover:url('/covers/cyberpunk-2077.jpg')"
        aria-hidden="true"
      >
      </div>
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--tr logo-accent--react logo-accent--strong"
      />
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--bl logo-accent--float logo-accent--purple logo-accent--sm"
      />
      <div class="split">
        <div class="split__copy">
          <p class="eyebrow" data-reveal="fade">New — the assistant moved in</p>
          <h2 class="display" data-fx="typewriter" data-fx-speed="45">
            Ask like a person. Answered like PITO.
          </h2>
          <p class="lede" data-reveal="rise">
            Type <code class="kbd">@ai</code> and just say it — <em
              >"compare my channels, chart the split"</em
            >. The assistant reads <span class="accent"
              >your library through PITO's own tools</span
            > and answers in PITO's native voice: real tables, braille charts, score
            bars — streaming in block by block, tables filling row by row. Bring <span
              class="accent">any model, your key, your call</span
            > — that answer on the right came from a free one. Every reply signs its
            work with the model's name and what it actually cost; the web stays out
            of it unless you say{" "}
            <code class="kbd">--web</code>.
          </p>
        </div>
        <figure class="split__media" data-reveal="zoom" data-tilt>
          <img
            decoding="async"
            src="/media/mkt-ai.gif"
            width="760"
            alt="Asking @ai to compare channels — PITO answers with a real table, a braille bar chart, and the model's ✨ receipt"
            loading="lazy"
          />
        </figure>
      </div>
    </Section>

    {/* ── 11.5 · MCP — CONNECT YOUR AI ─────────────────────── */}
    <Section id="mcp" theme="nord" label="" class="f-grotesk" data-fx-none>
      <div
        slot="decor"
        class="cover-bed"
        data-cover-slot="bed"
        style="--cover:url('/covers/tekken-7.jpg')"
        aria-hidden="true"
      >
      </div>
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--tr logo-accent--react logo-accent--strong"
      />
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--bl logo-accent--float logo-accent--cyan logo-accent--sm"
      />
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--tl logo-accent--float logo-accent--sm logo-accent--purple"
      />
      <div class="split">
        <div class="split__copy">
          <p class="eyebrow" data-reveal="fade">Bring your own AI</p>
          <h2 class="display" data-fx="typewriter" data-fx-speed="45">
            Your library. Your call.
          </h2>
          <p class="lede" data-reveal="rise">
            PITO speaks <code class="kbd">MCP</code>, so Claude on your phone,
            ChatGPT, or any MCP client can read your whole library — channels,
            vids, games, analytics — from wherever you are. <span class="accent"
              >Read-only, and every connection waits on the consent screen for
              your TOTP approval.</span
            > Your data, your control — here's{" "}
            <a href={GITHUB} class="pito-blue">how</a>.
          </p>
        </div>
        <figure class="split__media" data-reveal="zoom" data-tilt>
          <img
            decoding="async"
            src="/media/mkt-mcp.png"
            width="760"
            alt="The PITO OAuth consent screen, approving a new MCP client with a TOTP code"
            loading="lazy"
          />
        </figure>
      </div>
    </Section>

    {/* ── 6 · LOCAL AI — pinned scrollytelling ───────────────── */}
    <section
      id="voyage"
      class="scrolly"
      data-theme="synthwave"
      data-scrolly
      style="--steps: 7"
    >
      <div class="scrolly__stage">
        <span class="scrolly__hint">local AI · scroll through</span>
        <div class="scrolly__steps">
          <div class="scrolly__step" data-scrolly-step>
            <div
              class="scrolly__bed"
              style="--cover:url('/covers/pragmata.jpg')"
              aria-hidden="true"
            >
            </div>
            <h2 class="scrolly__big" data-fx="comet">You played a game.</h2>
            <p class="scrolly__sub">
              Tell PITO once. It pulls genres, themes, devs, and release from
              IGDB — the game becomes a first-class thing it can reason about.
            </p>
          </div>
          <div class="scrolly__step" data-scrolly-step>
            <div
              class="scrolly__bed"
              style="--cover:url('/covers/tekken-7.jpg')"
              aria-hidden="true"
            >
            </div>
            <p class="scrolly__arrow">game -></p>
            <h2 class="scrolly__big pito-blue" data-fx="comet">
              the channels it fits.
            </h2>
            <p class="scrolly__sub">
              Every game card surfaces the channels it pairs well with. Stop
              guessing where the footage belongs.
            </p>
          </div>
          <div class="scrolly__step" data-scrolly-step>
            <h2 class="scrolly__big" data-fx="comet">You run a channel.</h2>
            <p class="scrolly__sub">
              A channel is its videos. PITO already knows what you cover.
            </p>
          </div>
          <div class="scrolly__step" data-scrolly-step>
            <div
              class="scrolly__bed"
              style="--cover:url('/covers/elden-ring-nightreign.jpg')"
              aria-hidden="true"
            >
            </div>
            <p class="scrolly__arrow">channel -></p>
            <h2 class="scrolly__big pito-blue" data-fx="comet">
              the games that suit it.
            </h2>
            <p class="scrolly__sub">
              The channel-specific picks are computed from the games you've
              covered. <span class="accent nowrap">No guesswork, no vibes.</span
              >
            </p>
          </div>
          <div class="scrolly__step" data-scrolly-step>
            <div
              class="scrolly__bed"
              style="--cover:url('/covers/ghosts-n-goblins-resurrection.jpg')"
              aria-hidden="true"
            >
            </div>
            <h2 class="scrolly__big" data-fx="comet">
              Similar games, surfaced.
            </h2>
            <p class="scrolly__sub">
              Curious what to play next? PITO keeps fresh similar-games picks
              warm, computed at home.
            </p>
          </div>
          <div class="scrolly__step" data-scrolly-step>
            <h2 class="scrolly__big" data-fx="comet">
              It runs on <span class="pito-blue">your&nbsp;box</span>.
            </h2>
            <p class="scrolly__sub">
              The intelligence is local now. A 300-million-parameter embedding
              model lives inside your PITO stack — no API key, no per-call bill,
              no data leaving the server. Meaning-based search that works the
              same on day 1 and day 1000: free.
            </p>
          </div>
          <div class="scrolly__step" data-scrolly-step>
            <h2 class="scrolly__big" data-fx="comet">
              The more you publish, the sharper it gets.
            </h2>
            <p class="scrolly__sub">
              Recommendations are recomputed over time from everything you cover
              — your taste, encoded.
            </p>
          </div>
        </div>
        <span class="scrolly__counter" data-scrolly-progress>01 / 07</span>
      </div>
    </section>
  </section>

  {/* ── 7 · SEMANTIC SEARCH — two slides, one rail stop ────── */}
  <section id="search" data-nav-label="Search">
    {/* ── 6.5 · SEMANTIC SEARCH — type how it feels ──────────── */}
    <Section id="search-type" theme="tokyo-night" label="" class="f-grotesk">
      <div
        slot="decor"
        class="cover-bed"
        data-cover-slot="bed"
        style="--cover:url('/covers/demon-s-souls.jpg')"
        aria-hidden="true"
      >
      </div>
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--tr logo-accent--react"
      />
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--bl logo-accent--float logo-accent--sm logo-accent--cyan"
      />
      <div class="split">
        <div class="split__copy">
          <p class="eyebrow" data-reveal="fade">No keywords, no syntax</p>
          <h2 class="display" data-fx="typewriter" data-fx-speed="45">
            Type how it feels.
          </h2>
          <p class="lede" data-reveal="rise">
            <code class="kbd">search games with a good story</code>, or just say <em
              >"something brutal but worth every second."</em
            > PITO reads the meaning, not the words. <span class="accent"
              >Every game carries a curated trait vocabulary</span
            > — difficulty, story, pace, and more — so the search actually knows what
            "brutal" means. Typo and all, it still finds it — and it's honest when
            nothing in your library is close, instead of padding the list to fill
            it.
          </p>
        </div>
        <figure class="split__media" data-reveal="zoom" data-tilt>
          <img
            decoding="async"
            src="/media/mkt-semantic-search.png"
            width="760"
            alt="Searching games by feel — 'search games with a good story' returning a ranked list, no keywords required"
            loading="lazy"
          />
        </figure>
      </div>
    </Section>

    {/* slide 2 — the vibe query: same rail stop, different fx. */}
    <Section id="search-vibe" theme="dracula" label="" class="f-grotesk">
      <div
        slot="decor"
        class="cover-bed"
        data-cover-slot="bed"
        style="--cover:url('/covers/ghosts-n-goblins-resurrection.jpg')"
        aria-hidden="true"
      >
      </div>
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--tl logo-accent--float"
      />
      <PitoLogo
        slot="decor"
        class="logo-accent logo-accent--br logo-accent--react logo-accent--sm logo-accent--cyan"
      />
      <div class="split split--reverse">
        <div class="split__copy">
          <p class="eyebrow" data-reveal="blurin">Ask for a feeling</p>
          <h2 class="display" data-fx="scramble" data-reveal="skew">
            "Brutal but worth every second."
          </h2>
          <p class="lede" data-reveal="rise">
            <code class="kbd"
              >search games about brutal but worth every second</code
            >
            surfaces the punishing-but-loved shelf — closest match first at <span
              class="accent">100</span
            >, a pager for the rest. And when nothing in your library genuinely
            fits, PITO says so instead of padding the page: an honest empty
            beats a flattering wrong answer.
          </p>
        </div>
        <figure class="split__media" data-reveal="flip" data-tilt>
          <img
            decoding="async"
            src="/media/mkt-vibe-search.png"
            width="760"
            alt="search games about brutal but worth every second — the punishing-but-loved shelf ranked by meaning, closest match at 100, pager below"
            loading="lazy"
          />
        </figure>
      </div>
    </Section>
  </section>

  {/* ── COLOR BRIDGE ← local AI (REVERSED: splash → AI-reveal → shelf) ── */}
  <ColorBridge
    reverse
    letter="AI"
    color="#5170ff"
    ink="#0a0a12"
    text="local AI"
    sub="your box. your data. no bill."
    covers={[
      "/covers/terminator-2d-no-fate.jpg",
      "/covers/stellar-blade-blood-rain.jpg",
      "/covers/demon-s-souls.jpg",
      "/covers/cyberpunk-2077.jpg",
      "/covers/elden-ring.jpg",
      "/covers/nioh-3.jpg",
      "/covers/tekken-7.jpg",
      "/covers/pragmata.jpg",
      "/covers/elden-ring-nightreign.jpg",
      "/covers/ghosts-n-goblins-resurrection.jpg",
      "/covers/stellar-blade.jpg",
      "/covers/elden-ring.jpg",
      "/covers/cyberpunk-2077.jpg",
      "/covers/demon-s-souls.jpg",
    ]}
