---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import "../styles/said-buttons.css";
import "../styles/said-fx.css";
import "../styles/said-rail.css";
import SaidFooter from "../components/SaidFooter.astro";
import SaidShot from "../components/SaidShot.astro";
import McpRail from "../components/McpRail.astro";
import { MCP_ROW_ONE, MCP_ROW_TWO } from "../lib/mcp-clients";
import { released, withBadges, stamp } from "../lib/said-blog";

const posts = await getCollection("saidBlog");
const roll = (
  import.meta.env.DEV
    ? withBadges(posts)
    : released(posts).map((post) => ({ post, badge: null }))
).slice(0, 4);
---

<Base
  title="pitomd.com — Said and Done."
  description="The home of Pito's products. Said and Done., the desk that lives where your notes live, leads the lineup."
>
  <main class="home">
    <section class="home-hero">
      <canvas class="fx-aurora" data-mark aria-hidden="true"></canvas>
      <div class="said-mark-slot" aria-hidden="true"></div>
      <h1 class="home-name said-comet">
        <span class="hn-said">Said and</span>{" "}<span class="hn-done"
          >Done.</span
        >
      </h1>
      <p class="home-sub">
        The desk that lives where your notes live. Local, keyboard-first, and
        honest about every move.
      </p>
      <div class="home-cta">
        <a class="said-btn said-btn-primary" href="/said-and-done/"
          >Long story short</a
        >
        <a class="said-btn said-btn-ghost" href="/said-and-done/tour/"
          >Take the tour</a
        >
      </div>
      <div class="home-fan">
        <div class="home-fan-side home-fan-left">
          <SaidShot src="/said-and-done/shots/dossier.png" alt="" eager />
        </div>
        <div class="home-fan-center">
          <SaidShot
            src="/said-and-done/shots/board.png"
            alt="The Said and Done. board — four lanes carrying real cards"
            caption="The board, live — local, keyboard-first, honest."
            eager
          />
        </div>
        <div class="home-fan-side home-fan-right">
          <SaidShot src="/said-and-done/shots/casefile.png" alt="" eager />
        </div>
      </div>
    </section>

    <section class="home-rail" aria-label="Works with your agents">
      <p class="home-rail-line">
        Speaks MCP — any of these can sit at the desk:
      </p>
      <McpRail
        chips={MCP_ROW_ONE}
        label="MCP clients that work with Said and Done."
      />
      <McpRail
        chips={MCP_ROW_TWO}
        reverse
        label="More MCP clients that work with Said and Done."
      />
    </section>

    <section class="home-roll">
      <h2>From the blogs</h2>
      <div class="home-roll-grid">
        {
          roll.map(({ post, badge }) => (
            <a class="home-card" href={`/said-and-done/blog/${post.id}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="home-card-meta">
                Said and <span class="hn-done">Done.</span> ·{" "}
                {stamp(post.data.pubDate)}
                {badge && <em class="home-card-badge">{badge}</em>}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <SaidFooter brand={false}>
      <a class="freechat mono" href="/chat">The Free Chat</a>
    </SaidFooter>
  </main>

  <style>
    .freechat {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 8px 16px;
      border-radius: 999px;
      overflow: hidden;
      color: #fff;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      background: linear-gradient(
        115deg,
        #ff4d6d 0%,
        #ff2e93 34%,
        #a44dff 66%,
        #0fa8f0 100%
      );
      box-shadow:
        0 10px 30px -10px rgb(255 46 147 / 60%),
        inset 0 1px 0 rgb(255 255 255 / 55%),
        inset 0 -6px 14px rgb(0 0 0 / 25%);
    }

    .freechat::after {
      content: "";
      position: absolute;
      inset: 2px 2px 52% 2px;
      border-radius: 999px 999px 40% 40%;
      background: linear-gradient(
        rgb(255 255 255 / 42%),
        rgb(255 255 255 / 4%)
      );
      pointer-events: none;
    }

    .freechat:hover {
      filter: brightness(1.08);
    }

    .home {
      --font-serif:
        charter, "Bitstream Charter", "Iowan Old Style", georgia,
        "Times New Roman", serif;

      min-height: 100svh;
      display: flex;
      flex-direction: column;
    }

    .hn-done-dot {
      color: #0fa8f0;
      font-weight: 700;
    }

    .home-rail {
      padding: 2.4rem 0 0.6rem;
    }

    .home-rail-line {
      margin: 0 0 4px;
      text-align: center;
      color: rgb(171 180 200 / 80%);
      font-size: 0.9rem;
      letter-spacing: 0.05em;
    }

    .home-hero {
      position: relative;
      overflow: hidden;
      min-height: 92svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 1.4rem;
      padding: 6rem var(--section-pad-x) 3rem;
    }

    .home-hero > :not(.fx-aurora) {
      position: relative;
      z-index: 1;
    }

    .fx-aurora {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .home-fan {
      perspective: 1700px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      width: min(1500px, 100%);
      margin-top: clamp(1.6rem, 5vh, 3.6rem);
    }

    .home-fan :global(.said-shot) {
      width: 100%;
      margin: 0;
    }

    .home-fan-side {
      width: 30%;
      flex: 0 0 30%;
    }

    .home-fan-center {
      width: 52%;
      flex: 0 0 52%;
      z-index: 2;
    }

    .home-fan-center :global(.said-shot) {
      box-shadow:
        0 0 0 1px rgb(6 11 20 / 60%),
        0 0 120px -20px rgb(15 168 240 / 45%),
        0 50px 140px -40px rgb(0 0 0 / 85%);
    }

    .home-fan-left :global(.said-shot) {
      transform: rotateY(24deg) translateX(10%) scale(0.94);
      transform-origin: right center;
      opacity: 0.75;
    }

    .home-fan-right :global(.said-shot) {
      transform: rotateY(-24deg) translateX(-10%) scale(0.94);
      transform-origin: left center;
      opacity: 0.75;
    }

    .said-mark-slot {
      width: clamp(96px, 12vw, 148px);
      height: clamp(96px, 12vw, 148px);
      margin: 0 auto 6px;
    }

    .home-name {
      --comet-step: 55ms;

      margin: 0;
      font-family: "Martian Mono", ui-monospace, monospace;
      font-weight: 700;
      font-size: clamp(2.2rem, 9.4vw, 9rem);
      line-height: 1.12;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .hn-said {
      color: #eceff4;
    }

    .hn-done {
      color: #0fa8f0;
    }

    .home-sub {
      margin: 0;
      max-width: 54ch;
      font-family: var(--font-mono);
      font-size: clamp(0.95rem, 1.6vw, 1.15rem);
      opacity: 0.75;
    }

    .home-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }

    .home-roll {
      width: min(880px, 100%);
      margin: 0 auto;
      padding: 4.5rem var(--section-pad-x) 5.5rem;
      border-top: 1px solid rgb(255 255 255 / 8%);
    }

    .home-roll h2 {
      margin: 0 0 2.2rem;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      text-align: center;
      color: var(--fg-default, #eceff4);
    }

    .home-roll-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.4rem;
    }

    .home-card {
      display: block;
      padding: 1.7rem 1.8rem;
      border: 1px solid rgb(255 255 255 / 10%);
      border-radius: 14px;
      text-decoration: none;
      transition:
        border-color 140ms ease,
        filter 140ms ease;
    }

    .home-card:hover {
      border-color: var(--pito-blue);
      filter: brightness(1.1);
    }

    .home-card h3 {
      margin: 0 0 0.6rem;
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 1.35rem;
      line-height: 1.3;
      color: var(--fg-default, #eceff4);
    }

    .home-card p {
      margin: 0 0 0.9rem;
      font-family: var(--font-serif);
      font-size: 1.02rem;
      line-height: 1.55;
      opacity: 0.78;
    }

    .home-card-meta {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      opacity: 0.55;
    }

    .home-card-badge {
      font-style: normal;
      margin-left: 0.5rem;
      padding: 0 0.5rem;
      border: 1px solid rgb(240 104 122 / 55%);
      border-radius: 999px;
      color: #f0687a;
    }

    @media (width <= 640px) {
      .hn-done-dot {
        color: #0fa8f0;
        font-weight: 700;
      }

      .home-rail {
        padding: 2.4rem 0 0.6rem;
      }

      .home-rail-line {
        margin: 0 0 4px;
        text-align: center;
        color: rgb(171 180 200 / 80%);
        font-size: 0.9rem;
        letter-spacing: 0.05em;
      }

      .home-hero {
        min-height: 86svh;
        gap: 1.1rem;
        padding-top: 4.5rem;
      }

      .home-sub {
        font-size: 0.92rem;
      }

      .home-fan {
        margin-top: 1.6rem;
      }

      .home-roll-grid {
        grid-template-columns: 1fr;
      }

      .home-fan-side {
        display: none;
      }

      .home-fan-center {
        width: 100%;
        flex: 0 0 100%;
      }
    }
  </style>

  <script src="../scripts/said-hero-shader.js"></script>
  <script src="../scripts/said-reveal.js"></script>
</Base>
