  <Section id="free" theme="one-dark" label="$0 · private" class="f-serif">
    <img slot="decor" class="logo-accent logo-accent--watermark" src="/logo/pito-wordmark-white.png" alt="" aria-hidden="true" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--tr logo-accent--float logo-accent--sm logo-accent--green" />
    <PitoLogo slot="decor" class="logo-accent logo-accent--bl logo-accent--react logo-accent--sm" />
