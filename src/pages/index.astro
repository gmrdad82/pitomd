---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ColorBridge from "../components/ColorBridge.astro";
import PitoLogo from "../components/PitoLogo.astro";

// pitomd.com — the over-the-top, scroll-driven PITO showcase. One long page,
// a distinct theme + font + entrance per section, fx ported (in spirit) from
// pito. Sells and wows; every "how/where" resolves to GitHub. Copy is pito's
// house voice (dry, witty), much of it adapted from the app's own strings.

const GITHUB = "https://github.com/gmrdad82/pito";
const SPONSOR = "https://github.com/sponsors/gmrdad82";
const YOUTUBE = "https://www.youtube.com/@gmrdad82";
const X = "https://x.com/GamerDady82";
const DISCORD = "https://discord.gg/q947UyDTqJ";
const INSTALL = "curl -fsSL pitomd.com/install.sh | sh";

const avatars = [
  { file: "@gmrdad82.png", name: "Gamer Dad" },
  { file: "@gmrdad82good.png", name: "The Good" },
  { file: "@gmrdad82hard.png", name: "The Hard" },
  { file: "@gmrdad82fighter.png", name: "The Fighter" },
  { file: "@gmrdad82strategist.png", name: "The Strategist" },
  { file: "@gmrdad82survivor.png", name: "The Survivor" },
];

// Real game cover art exported from pito (the owner's own catalogue).
const covers = [
  { f: "elden-ring", t: "Elden Ring" },
  { f: "stellar-blade", t: "Stellar Blade" },
  { f: "cyberpunk-2077", t: "Cyberpunk 2077" },
  { f: "nioh-3", t: "Nioh 3" },
  { f: "demon-s-souls", t: "Demon's Souls" },
  { f: "tekken-7", t: "Tekken 7" },
  { f: "pragmata", t: "Pragmata" },
  { f: "elden-ring-nightreign", t: "Elden Ring Nightreign" },
  { f: "stellar-blade-blood-rain", t: "Stellar Blade: Blood Rain" },
  { f: "ghosts-n-goblins-resurrection", t: "Ghosts 'n Goblins Resurrection" },
  { f: "terminator-2d-no-fate", t: "Terminator 2D: No Fate" },
];
const depths = [12, 5, 9, 14, 6, 11, 4, 13, 7, 10, 8];
---

<Base>
  {/* Persistent social rail (left) — hidden on mobile. */}
  <nav class="socialbar" aria-label="Follow Catalin">
    <a href={YOUTUBE} aria-label="YouTube" data-magnetic
      ><img src="/social/youtube.svg" width="20" height="20" alt="" /></a
    >
    <a href={X} aria-label="X" data-magnetic
      ><img src="/social/x.svg" width="17" height="17" alt="" /></a
    >
    <a href={DISCORD} aria-label="Discord" data-magnetic
      ><img src="/social/discord.svg" width="20" height="20" alt="" /></a
    >
  </nav>

  {/* ── 1 · HERO ─────────────────────────────────────────── */}
  <Section id="hero" theme="synthwave" label="Start" class="hero f-grotesk">
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--react logo-accent--sm logo-accent--cyan"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--bl logo-accent--float logo-accent--sm logo-accent--purple"
    />
    <div class="hero__stack">
      <img
        class="hero__logo"
        src="/logo/pito-logo-hero.png"
        width="4140"
        height="1393"
        alt="PITO"
        fetchpriority="high"
        data-reveal="zoom"
      />
      <p class="eyebrow" data-reveal="fade">the best YouTube tool</p>
      <h1 class="display hero__title">
        <span data-fx="typewriter" data-fx-speed="55">one chatbox.</span><br />
        <span class="pito-blue" data-fx="typewriter" data-fx-speed="55"
          >every channel.</span
        >
      </h1>
      <p class="lede hero__lede" data-reveal="rise">
        A self-hosted command deck for the multi-channel creator. Type plain
        English, it answers. No tabs, no logging out, no
        <span class="nowrap">$50-a-month ransom.</span>
      </p>
      <div class="hero__cta" data-reveal="rise">
        <a class="btn btn--primary" href={GITHUB} data-magnetic
          >Get it on GitHub →</a
        >
        <a class="btn btn--ghost" href={YOUTUBE} data-magnetic
          >▶ Watch the tour</a
        >
      </div>
      <div
        class="copybox"
        data-copy={INSTALL}
        data-reveal="fade"
        title="Click to copy"
      >
        <span class="copybox__prompt mono">$</span>
        <code class="copybox__cmd mono" data-fx="comet">{INSTALL}</code>
        <button
          type="button"
          class="copybox__btn mono"
          data-copy-btn
          aria-label="Copy install command"
        >
          <span data-copy-label>⧉ copy</span>
        </button>
      </div>
    </div>
  </Section>

  {/* ── 2 · THE PAIN ─────────────────────────────────────── */}
  <Section id="pain" theme="dracula" label="The pain" class="f-heavy">
    <img
      slot="decor"
      class="logo-accent logo-accent--watermark"
      src="/logo/pito-wordmark-white.png"
      alt=""
      aria-hidden="true"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--sm logo-accent--react logo-accent--strong logo-accent--orange"
    />
    <p class="eyebrow" data-reveal="fade">If this is you</p>
    <h2 class="display" data-fx="scramble" data-reveal="skew">
      Log out. Log in. Repeat. Forever.
    </h2>
    <div class="prose" data-reveal="rise">
      <p>
        YouTube Studio, in its infinite wisdom, manages exactly
        <span class="accent">one channel at a time</span>. Run a handful and
        your day becomes a carousel of sign-outs and sign-ins until your will to
        live quietly files for unemployment.
      </p>
      <p>
        The paid tools? Social Blade, vidIQ, TubeBuddy — tried them, paid them,
        and not one did the specific things a real multi-channel creator needs.
        They'd love <span class="accent">$50+ a month</span>, please, forever,
        amen, for the privilege of <em>almost</em> fitting.
      </p>
    </div>
  </Section>

  {/* ── 3 · ONE CHATBOX ──────────────────────────────────── */}
  <Section id="chatbox" theme="tokyo-night" label="One chatbox" class="f-funk">
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tl logo-accent--float logo-accent--cyan"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--br logo-accent--sm logo-accent--react"
    />
    <div class="split">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">One box to rule them all</p>
        <h2 class="display" data-fx="comet">Type. It answers.</h2>
        <p class="lede" data-reveal="rise">
          No dashboards to learn, no menus to hunt. A single chatbox that speaks
          every one of your channels — see subs · vids · views for all of them
          in one <code class="kbd">list channels</code>.
        </p>
      </div>
      <figure
        class="split__media"
        data-reveal="right"
        data-tilt
        data-parallax="slow"
      >
        <img
          src="/media/01-chat.gif"
          width="760"
          alt="The PITO chatbox in action"
          loading="lazy"
        />
      </figure>
    </div>
  </Section>

  {/* ── 4 · PLAIN LANGUAGE ───────────────────────────────── */}
  <Section id="language" theme="nord" label="Plain language" class="f-mono">
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--br logo-accent--react"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tl logo-accent--float logo-accent--green logo-accent--sm"
    />
    <div class="split split--reverse">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">No syntax to memorize</p>
        <h2 class="display" data-fx="typewriter" data-fx-speed="45">
          Just say what you want.
        </h2>
        <p class="lede" data-reveal="rise">
          <code class="kbd">list vids</code>. <code class="kbd"
            >show game 42</code
          >.
          <code class="kbd">list games rpg ps5</code> filters by genre and platform
          — natural-ish, case-insensitive. PITO speaks human.
        </p>
      </div>
      <figure
        class="split__media"
        data-reveal="left"
        data-tilt
        data-parallax="slow"
      >
        <img
          src="/media/02-language.gif"
          width="760"
          alt="Plain-language commands in PITO"
          loading="lazy"
        />
      </figure>
    </div>
  </Section>

  {/* ── 5 · LINKAGE ──────────────────────────────────────── */}
  <Section id="linkage" theme="gruvbox-dark" label="Linkage" class="f-grotesk">
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--react"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--bl logo-accent--float logo-accent--sm logo-accent--orange"
    />
    <img
      slot="decor"
      src="/coin/coin.gif"
      class="pixel-accent pixel-accent--spin"
      style="top:14%;right:9%;width:120px;height:90px;opacity:.5"
      alt=""
      aria-hidden="true"
    />
    <div class="split">
      <div class="split__copy">
        <p class="eyebrow" data-reveal="fade">You tell it, it remembers</p>
        <h2 class="display" data-fx="comet">Games ↔ videos ↔ channels.</h2>
        <p class="lede" data-reveal="rise">
          <code class="kbd">import game</code> grabs genres, themes, devs, and release
          from IGDB. <code class="kbd">link</code> ties a video to a game — <span
            class="accent">PITO never guesses from titles, you tell it.</span
          >
        </p>
      </div>
      <figure
        class="split__media"
        data-reveal="right"
        data-tilt
        data-parallax="slow"
      >
        <img
          src="/media/03-linkage.gif"
          width="760"
          alt="Game-to-video linkage in PITO"
          loading="lazy"
        />
      </figure>
    </div>
  </Section>

  {/* ── 5.5 · LIBRARY — platforms + masonry covers ───────── */}
  <Section
    id="library"
    theme="tokyo-night"
    label="Your shelf"
    class="library f-grotesk"
  >
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tl logo-accent--react logo-accent--sm logo-accent--cyan"
    />
    <p class="eyebrow" data-reveal="fade">Every platform · every cover</p>
    <h2 class="display" data-fx="comet">Your shelf, alive.</h2>
    <p
      class="lede"
      data-reveal="rise"
      style="margin-inline:auto;max-width:44rem"
    >
      PlayStation, Switch, Steam — PITO knows what you own where, and pulls the
      real cover art in. Move your mouse through it.
    </p>

    <div class="platforms" data-reveal="rise" data-stagger>
      <img
        class="platform-icon"
        style="--i:0"
        src="/platforms/playstation.svg"
        width="120"
        height="120"
        alt="PlayStation"
        data-magnetic
        loading="lazy"
      />
      <img
        class="platform-icon"
        style="--i:1"
        src="/platforms/switch.svg"
        width="120"
        height="120"
        alt="Nintendo Switch"
        data-magnetic
        loading="lazy"
      />
      <img
        class="platform-icon"
        style="--i:2"
        src="/platforms/steam.svg"
        width="120"
        height="120"
        alt="Steam"
        data-magnetic
        loading="lazy"
      />
    </div>

    <div class="cover-wall">
      {
        covers.map((c, i) => (
          <figure
            class="cover"
            style={`--d:${depths[i] ?? 8}`}
            data-reveal="zoom"
          >
            <img
              src={`/covers/${c.f}.jpg`}
              width="374"
              height="499"
              alt={c.t}
              loading="lazy"
            />
          </figure>
        ))
      }
    </div>
  </Section>

  {/* ── COLOR BRIDGE → Voyage ─────────────────────────────── */}
  <ColorBridge
    letter="V"
    color="#5170ff"
    ink="#0a0a12"
    text="Voyage AI"
    sub="game ↔ channel. both ways."
  />

  {/* ── 6 · VOYAGE — pinned scrollytelling ───────────────── */}
  <section
    id="voyage"
    class="scrolly"
    data-theme="synthwave"
    data-nav-label="Voyage AI"
    data-scrolly
    style="--steps: 7"
  >
    <div class="scrolly__stage">
      <span class="scrolly__hint">Voyage AI · scroll through</span>
      <div class="scrolly__steps">
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big" data-fx="comet">You played a game.</h2>
          <p class="scrolly__sub">
            Tell PITO once. It pulls genres, themes, devs, and release from IGDB
            — the game becomes a first-class thing it can reason about.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <p class="scrolly__arrow">game →</p>
          <h2 class="scrolly__big pito-blue" data-fx="comet">
            the channels it fits.
          </h2>
          <p class="scrolly__sub">
            Every game card surfaces the channels it pairs well with. Stop
            guessing where the footage belongs.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big" data-fx="comet">You run a channel.</h2>
          <p class="scrolly__sub">
            A channel is its videos. PITO already knows what you cover.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <p class="scrolly__arrow">channel →</p>
          <h2 class="scrolly__big pito-blue" data-fx="comet">
            the games that suit it.
          </h2>
          <p class="scrolly__sub">
            The channel-specific picks are computed from the games you've
            covered. <span class="accent nowrap">No guesswork, no vibes.</span>
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big" data-fx="comet">Similar games, surfaced.</h2>
          <p class="scrolly__sub">
            Curious what to play next? Voyage AI keeps fresh similar-games picks
            warm in the background.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big" data-fx="comet">
            It runs on <span class="pito-blue">Voyage&nbsp;AI</span>.
          </h2>
          <p class="scrolly__sub">
            Best-in-class semantic embeddings — the same calibre of model the
            serious AI shops reach for. No keyword guessing; real meaning.
          </p>
        </div>
        <div class="scrolly__step" data-scrolly-step>
          <h2 class="scrolly__big" data-fx="comet">
            The more you publish, the sharper it gets.
          </h2>
          <p class="scrolly__sub">
            Recommendations are recomputed over time from everything you cover —
            your taste, encoded.
          </p>
        </div>
      </div>
      <span class="scrolly__counter" data-scrolly-progress>01 / 07</span>
    </div>
  </section>

  {/* ── 7 · FOOTAGE ──────────────────────────────────────── */}
  <Section id="footage" theme="ayu-dark" label="Footage" class="f-round">
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--react logo-accent--strong"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--bl logo-accent--float logo-accent--cyan logo-accent--sm"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tl logo-accent--float logo-accent--sm"
    />
    <p class="eyebrow" data-reveal="fade">Time is the real budget</p>
    <h2 class="display" data-fx="comet">Track the footage.</h2>
    <p
      class="lede"
      data-reveal="rise"
      style="margin-inline:auto;max-width:42rem"
    >
      Recorded-but-unpublished hours per game, kept as a manual
      <code class="kbd">footage</code> total, plotted against the game's time-to-beat.
      The time you've sunk is an investment — PITO makes it visible.
    </p>
    {
      /* Real Pito::TimeToBeatComponent — heat-mapped fuel gauge with the footage
        tick, rendered from pito. Per-game adaptive gradient (inline). */
    }
    <div class="pito-widget" data-reveal="rise" data-tilt>
      <div class="pito-ttb" data-component="time-to-beat">
        <span class="pito-ttb__label">Time spend</span>
        <div class="pito-ttb__body">
          <div class="pito-ttb__values pito-ttb__values--top">
            <div
              class="pito-ttb__footage-bubble ttb-label--at-start"
              data-accent="footage"
              style="left: 8.75%;"
            >
              <span class="pito-ttb__footage-bubble-num">12h</span>
              <span class="pito-ttb__footage-bubble-arrow">&#9660;</span>
            </div>
          </div>
          <div class="pito-ttb__bar-row">
            <span class="pito-ttb__bar">
              <span class="pito-ttb__track">
                <span class="pito-ttb__bracket">[</span>
                <span
                  class="pito-ttb__fill pito-bar-shimmer pito-shimmer-d10"
                  style="background-image: var(--pito-bar-band, linear-gradient(transparent, transparent)), linear-gradient(to right in oklch, color-mix(in oklch, var(--accent-green) 70%, var(--fg-default)) 0.0%, color-mix(in oklch, color-mix(in oklch, var(--accent-green), var(--accent-yellow)) 58%, var(--fg-default)) 8.06%, color-mix(in oklch, color-mix(in oklch, var(--accent-orange) 60%, var(--accent-yellow)) 58%, var(--fg-default)) 32.26%, color-mix(in oklch, var(--accent-red), var(--accent-purple)) 80.65%, color-mix(in oklch, var(--accent-red), var(--accent-purple)) 100%);"
                  ></span
                >
                <span class="pito-ttb__bracket">]</span>
              </span>
              <span
                class="pito-ttb__tick ttb-tick--main"
                data-accent="main"
                style="left: 26.25%;">|</span
              >
              <span
                class="pito-ttb__tick ttb-tick--extras"
                data-accent="extras"
                style="left: 56.25%;">|</span
              >
              <span
                class="pito-ttb__tick ttb-tick--completionist"
                data-accent="completionist"
                style="left: 98.75%;">|</span
              >
              <span
                class="pito-ttb__tick ttb-tick--footage"
                data-accent="footage"
                style="left: 8.75%;">|</span
              >
            </span>
          </div>
          <div class="pito-ttb__values pito-ttb__values--bottom">
            <span
              class="pito-ttb__value pito-ttb__value--pillar ttb-label--centered"
              data-pillar="main"
              style="left: 26.25%;">31h</span
            >
            <span
              class="pito-ttb__value pito-ttb__value--pillar ttb-label--centered"
              data-pillar="extras"
              style="left: 56.25%;">71h</span
            >
            <span
              class="pito-ttb__value pito-ttb__value--pillar ttb-label--at-end"
              data-pillar="completionist"
              style="left: 98.75%;">124h</span
            >
          </div>
          <div class="pito-ttb__legend">
            <span class="pito-ttb__legend-item"
              ><span class="pito-ttb__legend-tick" data-accent="main">|</span
              ><span class="pito-ttb__legend-label">main</span></span
            >
            <span class="pito-ttb__legend-item"
              ><span class="pito-ttb__legend-tick" data-accent="extras">|</span
              ><span class="pito-ttb__legend-label">extras</span></span
            >
            <span class="pito-ttb__legend-item"
              ><span class="pito-ttb__legend-tick" data-accent="completionist"
                >|</span
              ><span class="pito-ttb__legend-label">completionist</span></span
            >
            <span class="pito-ttb__legend-item"
              ><span class="pito-ttb__legend-tick" data-accent="footage">|</span
              ><span class="pito-ttb__legend-label">footage</span></span
            >
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ── 8 · PRICE / COINS ────────────────────────────────── */}
  {
    /* Coin/star glyphs + tier map are pito's exact spec (Pito::Coin):
      ≤9.99→1 · ≤29.99→2 · ≤59.99→3 · ≤79.99→4 · >79.99→5 · free→star. */
  }
  <Section id="price" theme="gruvbox-dark" label="Price" class="f-funk">
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--bl logo-accent--float logo-accent--orange"
    />
    <PitoLogo
      slot="decor"
      class="logo-accent logo-accent--tr logo-accent--react logo-accent--sm"
    />
    {/* coins gone feral — big, distorted, spinning pixel art */}
    <img
      slot="decor"
      src="/coin/coin.gif"
      class="pixel-accent pixel-accent--spin"
      style="top:11%;left:6%;width:130px;height:98px;opacity:.6"
      alt=""
      aria-hidden="true"
    />
    <img
      slot="decor"
      src="/coin/coin.gif"
      class="pixel-accent pixel-accent--bob"
      style="bottom:12%;right:7%;width:190px;height:143px;opacity:.5"
      alt=""
      aria-hidden="true"
    />
    <img
      slot="decor"
      src="/coin/coin.gif"
      class="pixel-accent pixel-accent--squash"
      style="top:16%;right:13%;width:104px;height:150px;opacity:.4"
      alt=""
      aria-hidden="true"
    />
    <img
      slot="decor"
      src="/coin/coin.gif"
      class="pixel-accent pixel-accent--react"
      style="bottom:26%;left:12%;width:230px;height:96px;opacity:.45"
      alt=""
      aria-hidden="true"
    />
    <p class="eyebrow" data-reveal="fade">Value per coin</p>
    <h2 class="display" data-fx="scramble">What did it cost you?</h2>
    <p
      class="lede"
      data-reveal="rise"
      style="margin-inline:auto;max-width:42rem"
    >
      <code class="kbd">price set 42 59.99</code> records what
      <span class="accent">you</span> paid to acquire the game — your money, your
      number. The coins read that spend at a glance — one for budget, five for collector
      — and the <span class="accent">star</span> means you got it free.
    </p>
    <div class="coins" data-reveal="rise" data-stagger>
      <span class="coin-chip" style="--i:0">
        <span class="glyphs"
          ><img src="/coin/coin.gif" alt="" width="64" height="48" /></span
        >
        <span class="num">9.99</span>
      </span>
      <span class="coin-chip" style="--i:1">
        <span class="glyphs"
          ><img src="/coin/coin.gif" alt="" width="64" height="48" /><img
            src="/coin/coin.gif"
            alt=""
            width="64"
            height="48"
          /><img src="/coin/coin.gif" alt="" width="64" height="48" /></span
        >
        <span class="num">59.99</span>
      </span>
      <span class="coin-chip" style="--i:2">
        <span class="glyphs"
          ><img src="/coin/coin.gif" alt="" width="64" height="48" /><img
            src="/coin/coin.gif"
