---
import SaidDocsLayout from "../../../layouts/SaidDocsLayout.astro";
import { saidGuides } from "../../../data/said-guides";
---

<SaidDocsLayout
  title="Guides — Said and Done."
  description="Step-by-step guides for Said and Done.: first boot, the keyboard, and connecting your AI agents to your desk."
  section="guides"
  kicker="Guides"
  heading="Shown, step by step."
  dek="Each guide walks one feature from cold start to habit — short, honest, and in the order the desk teaches them."
>
  <div class="sdoc-entrylist" style="margin-top: 28px;">
    {
      saidGuides.map((g, i) => (
        <a class="sdoc-entry" href={`/said-and-done/guides/${g.slug}/`}>
          <p class="sdoc-guide-kicker">
            Guide 0{i + 1} · {g.sections.length} steps
          </p>
          <h2>
            {g.title.endsWith(".") ? g.title.slice(0, -1) : g.title}
            <span class="sdoc-dot">.</span>
          </h2>
          <p>{g.blurb}</p>
        </a>
      ))
    }
  </div>
</SaidDocsLayout>
