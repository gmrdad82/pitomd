---
import SaidShot from "../../components/SaidShot.astro";
import SaidLayout from "../../layouts/SaidLayout.astro";
import McpRail from "../../components/McpRail.astro";
import { MCP_ALL } from "../../lib/mcp-clients";
import SaidPlaceholder from "../../components/SaidPlaceholder.astro";
import SaidPhoneTicker from "../../components/SaidPhoneTicker.astro";
---

<SaidLayout
  title="The tour — Said and Done."
  description="Nine reasons Said and Done. earns a place on your desk: all local, yours forever, on-device AI, MCP-ready, automatic references, the record, GPU-fast meaning search, every OS, and a remote client."
  active="tour"
>
  <header class="said-hero" style="min-height: 62svh;">
    <canvas class="fx-aurora" data-mark data-mark-wash aria-hidden="true"
    ></canvas>
    <div class="said-eyebrow said-rise">The tour</div>
    <h1
      class="said-rise said-rise-2"
      style="font-size: clamp(2.8rem, 8vw, 6.5rem);"
    >
      Every feature,<br />plainly said<span class="dot">.</span>
    </h1>
    <p class="said-hero-sub said-rise said-rise-3">
      <span class="said-lead">//</span> Nine things <span class="hn-said"
        >Said and</span
      >{" "}<span class="hn-done">Done.</span> does, in the order they matter.
    </p>
    <div class="said-cta-row said-rise said-rise-4">
      <a class="said-btn said-btn-primary" href="/said-and-done/download/"
        >Download</a
      >
      <a class="said-btn said-btn-ghost" href="/said-and-done/buy-now/"
        >Unlock everything — 4.99€</a
      >
    </div>
  </header>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">01 · All local</p>
      <h2>Everything happens on your machine<span class="dot">.</span></h2>
      <p class="said-note">
        One local database, your notes read in place, nothing sent anywhere to
        make any feature work. No account, no cloud, no sync service between you
        and your own plans.
      </p>
      <SaidShot
        src="/said-and-done/shots/board.png"
        alt="The Said and Done. record — real Pages wearing their statuses, entirely local"
        caption="The record, all local — real Pages, your own machine."
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">02 · Forever yours</p>
      <h2>
        Free forever<span class="dot">.</span> Unlocked for 4<span class="dot"
          >.</span
        >99€<span class="dot">.</span>
      </h2>
      <p class="said-note">
        The free desk runs on as many devices as you own*. One 4.99€ licence
        unlocks unlimited everything on two devices** — pay once, keep it, no
        subscription.
      </p>
      <div class="said-tiers">
        <div class="said-tier-card">
          <h3>Free</h3>
          <ul>
            <li>The whole desk — the record, case files, search, backups</li>
            <li>Unlimited devices</li>
            <li>Up to 5 Notebooks, 10 Chapters, 100 Pages</li>
          </ul>
        </div>
        <div class="said-tier-card is-paid">
          <h3>Licensed · 4.99€</h3>
          <ul>
            <li>Everything in Free</li>
            <li>Unlimited Notebooks, Chapters, Pages</li>
            <li>One payment, yours forever, updates included</li>
          </ul>
        </div>
      </div>
      <p class="said-note">
        *Free: every feature, capped at 5 Notebooks, 10 Chapters, and 100 Pages.<br
        />
        **Licensed: no caps anywhere, one key covers 2 devices, moved freely.
      </p>
      <div class="said-cta-row" style="margin-top: 22px;">
        <a class="said-btn said-btn-primary" href="/said-and-done/buy-now/"
          >Get the licence</a
        >
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">03 · Local AI</p>
      <h2>AI that lives in the box<span class="dot">.</span></h2>
      <p class="said-note">
        An on-device embedding model indexes your markdown as you write it —
        smart matching between what you type and what you meant, computed at
        home, sent nowhere.
      </p>
      <SaidShot
        src="/said-and-done/shots/finder.png"
        alt="The finder — an exact hit on top, meaning matches beneath it"
        caption="One search, two kinds of hits — exact words on top, meaning underneath."
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">04 · AI-ready</p>
      <h2>
        Speaks MCP<span class="dot">.</span> Works with your agents<span
          class="dot">.</span
        >
      </h2>
      <p class="said-note">
        Any MCP client can sit at your desk: list Chapters, search notes, file
        and resolve Pages, leave Updates. Every action signed with the agent's
        own name, exactly like yours.
      </p>
      <McpRail
        chips={MCP_ALL}
        repeat={3}
        label="MCP clients that work with Said and Done."
      />
      <p class="said-note" style="margin-top: 26px;">
        Two doors, both yours. While the desk is open, a Streamable-HTTP door
        answers on your machine — and for clients that spawn their own servers,
        the same desk speaks stdio. One line connects either:
      </p>
      <pre
        class="said-mcp-line"><code>claude mcp add --transport http said-and-done http://127.0.0.1:5181/mcp</code></pre>
      <p class="said-fine">
        Checked against each client's own docs, not vibes. ChatGPT's connectors
        reach only public HTTPS, so it joins through a tunnel you own; Claude
        Desktop sits down through the stdio door.
      </p>
      <SaidShot
        src="/said-and-done/shots/casefile.png"
        alt="A case file where an agent reports its fix under its own name"
        caption="agent:quartermaster reports from the desk — its Update signed like anyone else's."
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">05 · References</p>
      <h2>It remembers where every thought lives<span class="dot">.</span></h2>
      <p class="said-note">
        Pages point at the exact lines of the markdown they came from —
        suggested automatically at birth, readable in place, tracked as your
        files change. The record never drifts from the thinking behind it.
      </p>
      <div class="said-duo">
        <div>
          <SaidShot
            src="/said-and-done/shots/card-light.png"
            alt="A Page with its file references and line ranges"
            caption="A Page wearing its references — files and line ranges, not links."
            class="said-reveal said-zoom"
          />
        </div>
        <div>
          <SaidShot
            src="/said-and-done/shots/reference.png"
            alt="A reference read in place — the exact markdown lines, rendered"
            caption="The referenced lines, read in place without leaving the Page."
            class="said-reveal said-zoom"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">06 · The record</p>
      <h2>
        One record<span class="dot">.</span> Every Page accounted for<span
          class="dot">.</span
        >
      </h2>
      <p class="said-note">
        Each Chapter is one running record — every Page a line in it, freshest
        first, wearing its status. Any Page opens as a case file: body,
        references, Thoughts and Updates, and history on one sheet. Nothing to
        arrange, nothing to tidy; the record keeps itself.
      </p>
      <div class="said-duo">
        <div>
          <SaidShot
            src="/said-and-done/shots/dossier-light.png"
            alt="The record — one running account of every Page"
            caption="The record — every Page as one running line."
            class="said-reveal said-zoom"
          />
        </div>
        <div>
          <SaidShot
            src="/said-and-done/shots/casefile.png"
            alt="A case file — one Page's whole life on one sheet"
            caption="The case file — a Page's whole life on one sheet."
            class="said-reveal said-zoom"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">07 · GPU fast</p>
      <h2>Meaning search at GPU speed<span class="dot">.</span></h2>
      <p class="said-note">
        The embedding engine rides your graphics card — indexing in the
        background, answering in milliseconds, never blocking a keystroke.
        Blazing on a gaming rig, quiet on a laptop.
      </p>
      <SaidShot
        src="/said-and-done/shots/projects.png"
        alt="The Notebook switcher answering instantly"
        caption="The switcher — Notebooks answer as fast as you can type."
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">08 · Every OS</p>
      <h2>
        Linux, macOS, Windows<span class="dot">.</span> One installer each<span
          class="dot">.</span
        >
      </h2>
      <p class="said-note">
        Native installers with everything bundled — the engine, the tools, the
        desk. Nothing downloads at boot; uninstalling never touches your data or
        your notes.
      </p>
      <div class="said-dl-grid" style="margin-top: 34px;">
        <div class="said-dl-card" data-os="linux">
          <img
            class="said-dl-mark"
            src="/said-and-done/os/linux.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <span class="said-dl-os">Linux</span>
          <h2>The .run</h2>
          <p>
            Self-installing: your user, your app menu, a clean uninstaller. No
            elevation, no system folders.
          </p>
        </div>
        <div class="said-dl-card" data-os="mac">
          <img
            class="said-dl-mark"
            src="/said-and-done/os/apple.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <span class="said-dl-os">macOS</span>
          <h2>The .dmg</h2>
          <p>
            Drag to Applications, done. Apple Silicon, everything inside the
            bundle.
          </p>
        </div>
        <div class="said-dl-card" data-os="windows">
          <img
            class="said-dl-mark"
            src="/said-and-done/os/windows.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <span class="said-dl-os">Windows</span>
          <h2>The .exe</h2>
          <p>
            Per-user install — no admin prompt, a normal Add/Remove entry,
            updates that can actually update.
          </p>
        </div>
      </div>
      <div class="said-cta-row" style="margin-top: 26px;">
        <a class="said-btn said-btn-ghost" href="/said-and-done/download/"
          >See the installers</a
        >
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">09 · Remote</p>
      <h2>The desk in your pocket<span class="dot">.</span></h2>
      <p class="said-note">
        A packed-in remote client rides the same desk from your phone, through
        your own tunnel, with one token. The window closed means the remote is
        off — no daemon, no surprise surface.
      </p>
      <SaidPhoneTicker
        frames={[
          {
            src: "/said-and-done/shots/remote/r-board-dark.png",
            alt: "The remote client on a phone — the record's backlog",
          },
          {
            src: "/said-and-done/shots/remote/r-board-light.png",
            alt: "The to-do Pages on the phone",
          },
          {
            src: "/said-and-done/shots/remote/r-card-dark.png",
            alt: "A Page opened on the phone — references read in place",
          },
          {
            src: "/said-and-done/shots/remote/r-dossier-light.png",
            alt: "The record on the phone — one running account",
          },
          {
            src: "/said-and-done/shots/remote/r-dossier-dark.png",
            alt: "The record on the phone, scrolled deeper",
          },
          {
            src: "/said-and-done/shots/remote/r-desk-dark.png",
            alt: "The remote's desk screen — the desk at a glance",
          },
        ]}
      />
      <div class="said-cta-row" style="margin-top: 40px;">
        <a class="said-btn said-btn-primary" href="/said-and-done/buy-now/"
          >Unlock everything — 4.99€</a
        >
        <a class="said-btn said-btn-ghost" href="/said-and-done/guides/"
          >Read the guides</a
        >
      </div>
    </div>
  </section>
</SaidLayout>
