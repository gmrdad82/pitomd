---
import { getCollection } from "astro:content";
import SaidDocsLayout from "../../../layouts/SaidDocsLayout.astro";
import { released, withBadges, stamp } from "../../../lib/said-blog";

const posts = await getCollection("saidBlog");
const entries = import.meta.env.DEV
  ? withBadges(posts)
  : released(posts).map((post) => ({ post, badge: null }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "The Said and Done blog",
  description:
    "Notes from the desk: planning where your notes live, keyboard-first work, and AI teammates that sign their work.",
  url: new URL("/said-and-done/blog/", Astro.site).toString(),
};
---

<SaidDocsLayout
  title="Blog — Said and Done"
  description="Notes from the desk: essays on planning where your notes live, keyboard-first work, and AI teammates that sign their work."
  section="blog"
  kicker="The blog"
  heading="Notes from the desk."
  dek="Essays on working where your notes live — planning, keyboards, named teammates, and keeping your own data."
  flavor="paper"
  jsonLd={jsonLd}
>
  <div class="sdoc-entrylist" style="margin-top: 28px;">
    {
      entries.map(({ post, badge }) => (
        <a class="sdoc-entry sdoc-entry-serif" href={`/said-and-done/blog/${post.id}/`}>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="sdoc-entry-meta">
            {stamp(post.data.pubDate)}
            {badge && (
              <span class:list={["sdoc-badge", `sdoc-badge-${badge}`]}>
                {badge === "scheduled"
                  ? `scheduled · publishes ${stamp(post.data.pubDate)}`
                  : "draft — awaiting the nod"}
              </span>
            )}
          </div>
        </a>
      ))
    }
  </div>
</SaidDocsLayout>
