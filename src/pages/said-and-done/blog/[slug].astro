---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SaidDocsLayout from "../../../layouts/SaidDocsLayout.astro";
import { released, withBadges, related, stamp } from "../../../lib/said-blog";

export async function getStaticPaths() {
  const posts = await getCollection("saidBlog");
  const visible = import.meta.env.DEV
    ? withBadges(posts).map(({ post }) => post)
    : released(posts);
  return visible.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"saidBlog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const posts = await getCollection("saidBlog");
const more = related(post, posts);
const badge = !post.data.published
  ? "draft"
  : post.data.pubDate.getTime() > Date.now()
    ? "scheduled"
    : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  author: { "@type": "Organization", name: "Pito" },
  url: new URL(`/said-and-done/blog/${post.id}/`, Astro.site).toString(),
};

const meta = badge
  ? `${stamp(post.data.pubDate)} <span class="sdoc-badge sdoc-badge-${badge}">${
      badge === "scheduled"
        ? `scheduled · publishes ${stamp(post.data.pubDate)}`
        : "draft — awaiting the nod"
    }</span>`
  : `Published ${stamp(post.data.pubDate)}`;
---

<SaidDocsLayout
  title={`${post.data.title} — Said and Done. blog`}
  description={post.data.description}
  section="blog"
  kicker="The blog"
  heading={post.data.title}
  meta={meta}
  progress={true}
  serif={true}
  flavor="paper"
  jsonLd={jsonLd}
>
  {
    toc.length > 1 && (
      <nav class="sdoc-toc-box" aria-label="Table of contents">
        <p>In this piece</p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <Content />
  <div slot="after">
    {
      more.length > 0 && (
        <div class="sdoc-related">
          <p class="sdoc-related-label">More from the blogs</p>
          <div class="sdoc-related-grid">
            {more.map((m) => (
              <a
                class="sdoc-related-card"
                href={`/said-and-done/blog/${m.id}/`}
              >
                <h3>{m.data.title}</h3>
                <span>
                  Said and <span class="hn-done">Done.</span> ·{" "}
                  {stamp(m.data.pubDate)}
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</SaidDocsLayout>
