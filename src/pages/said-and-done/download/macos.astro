---
import SaidLayout from "../../../layouts/SaidLayout.astro";
---

<SaidLayout
  title="Said and Done. is downloading — macOS"
  description="Your .dmg is on its way. Drag to Applications, then tell Gatekeeper it's fine — right-click, Open, once."
>
  <section class="said-frame" style="padding-top: 48px;">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">Downloading for macOS</p>
      <h2>Drag it in, open it once<span class="dot">.</span></h2>
      <p>
        Your <code>.dmg</code> is on its way. It carries the whole app — Apple
        Silicon build, engine included, nothing else to fetch.
      </p>

      <div class="said-after-art" aria-hidden="true">
        <svg viewBox="0 0 560 240" role="img">
          <rect x="20" y="18" width="330" height="204" rx="14" fill="var(--said-card)" stroke="var(--said-line)" />
          <rect x="52" y="70" width="84" height="84" rx="18" fill="rgb(15 168 240 / 18%)" stroke="var(--said-blue)" />
          <text x="94" y="122" font-family="var(--said-display)" font-size="26" font-weight="700" fill="var(--said-blue)" text-anchor="middle">S.</text>
          <path d="M154 112 h56" stroke="var(--said-sky)" stroke-width="3" stroke-dasharray="6 6">
            <animate attributeName="stroke-dashoffset" values="12;0" dur="0.9s" repeatCount="indefinite" />
          </path>
          <path d="M204 104 l14 8 -14 8 z" fill="var(--said-sky)" />
          <rect x="232" y="70" width="84" height="84" rx="18" fill="rgb(148 225 255 / 8%)" stroke="var(--said-line)" />
          <text x="274" y="116" font-family="var(--said-body)" font-size="34" fill="var(--said-faint)" text-anchor="middle">A</text>
          <text x="274" y="176" font-family="var(--said-body)" font-size="12" fill="var(--said-faint)" text-anchor="middle">Applications</text>
          <rect x="368" y="48" width="172" height="140" rx="12" fill="var(--said-card)" stroke="var(--said-line)" />
          <text x="384" y="80" font-family="var(--said-body)" font-size="12" fill="var(--said-ink)">Right-click the app</text>
          <text x="384" y="102" font-family="var(--said-body)" font-size="12" fill="var(--said-blue)">→ Open</text>
          <text x="384" y="132" font-family="var(--said-body)" font-size="11" fill="var(--said-faint)">Gatekeeper asks once,</text>
          <text x="384" y="150" font-family="var(--said-body)" font-size="11" fill="var(--said-faint)">then never again.</text>
        </svg>
      </div>

      <ol class="said-after-steps">
        <li>Open the <code>.dmg</code> and drag <strong>Said and Done.</strong> into Applications.</li>
        <li>First launch: <strong>right-click the app → Open → Open</strong>. macOS flags apps from outside the App Store until our notarization lands — one approval and it remembers.</li>
        <li>Blocked anyway? System Settings → Privacy &amp; Security → <strong>Open Anyway</strong>.</li>
      </ol>
      <p class="said-note said-after-note">
        Release builds arrive signed and notarized — from then on it opens with
        a plain double-click. The right-click dance is only for these
        release-candidate builds.
      </p>
      <div class="said-cta-row" style="margin-top: 26px;">
        <a class="said-btn said-btn-primary" href="/said-and-done/guides/first-boot/">First boot, step by step</a>
        <a class="said-btn said-btn-ghost" href="/said-and-done/download/">Back to downloads</a>
      </div>
    </div>
  </section>
</SaidLayout>
