---
import SaidShot from "../../components/SaidShot.astro";
import SaidLedger from "../../components/SaidLedger.astro";
import McpRail from "../../components/McpRail.astro";
import { MCP_ROW_ONE, MCP_ROW_TWO } from "../../lib/mcp-clients";
import SaidLayout from "../../layouts/SaidLayout.astro";
---

<SaidLayout
  title="Said and Done. — the desk that keeps its word"
  description="Your markdown notes become notebooks, chapters, and pages — local, keyboard-first, with an AI teammate that signs its work. Said and Done."
>
  <header class="said-hero said-hero-desk">
    <canvas class="fx-aurora" data-mark aria-hidden="true"></canvas>
    <div class="said-mark-slot said-mark-slot-corner" aria-hidden="true"></div>
    <div class="desk-cols">
      <div class="desk-copy said-rise">
        <p class="desk-eyebrow">
          Said and <span class="desk-eyebrow-done">Done.</span>
        </p>
        <h1 class="desk-title">
          The desk that lives where your notes live<span class="dot">.</span>
        </h1>
        <p class="desk-sub">
          Your markdown folders become notebooks, chapters, and pages — local,
          keyboard-first, and honest about every move.
        </p>
        <div class="said-cta-row said-rise said-rise-3">
          <a class="said-btn said-btn-primary" href="/said-and-done/tour/"
            >Take the tour</a
          >
          <a class="said-btn said-btn-ghost" href="/said-and-done/download/"
            >Download</a
          >
        </div>
      </div>
      <div class="desk-stage said-rise said-rise-3">
        <div class="desk-stage-back">
          <SaidShot src="/said-and-done/shots/casefile.png" alt="" eager />
        </div>
        <div class="desk-stage-front">
          <SaidShot
            src="/said-and-done/shots/board.png"
            alt="The Said and Done. record — real pages with their statuses, each with references into markdown notes"
            caption="The record, live on a real notebook."
            eager
          />
        </div>
      </div>
    </div>
  </header>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">01 · The notes are the plan</p>
      <h2>Your notes are already the plan<span class="dot">.</span></h2>
      <p class="said-note">
        Point <span class="hn-said">Said and</span>{" "}<span class="hn-done"
          >Done.</span
        > at the folder where your thinking lives. Every folder inside becomes a notebook;
        nothing is copied, nothing is moved. Pages reference the exact lines in your
        markdown they came from — so the plan and the work never drift apart.
      </p>
      <div class="said-duo">
        <SaidShot
          src="/said-and-done/shots/reference.png"
          alt="A page's reference read in place — the markdown lines it points at, rendered inside the page"
          caption="The exact markdown lines a page points at, rendered where you need them."
          class="said-reveal said-zoom"
        />
        <SaidShot
          src="/said-and-done/shots/overview-light.png"
          alt="The overview — pages and files as one web, a tooltip listing what a page references"
          caption="The Overview — every page and every file it touches, one living web."
          class="said-reveal said-zoom"
        />
      </div>
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">Free is the product</p>
      <h2>Most people never pay a cent<span class="dot">.</span></h2>
      <p class="said-note">
        The free desk has no clock and no watermark — five notebooks, ten
        chapters, a hundred living pages, every key, forever. One payment of
        4.99€ lifts the caps on two devices when you outgrow it. No
        subscription, no account, no tracking.
      </p>
      <SaidLedger />
    </div>
  </section>

  <section
    class="said-frame--tile said-scrolly"
    data-scrolly
    style="--steps: 3"
  >
    <div class="said-scrolly-stage">
      <span class="said-scrolly-hint">02 · One record · scroll through</span>
      <div
        class="said-ticker-dots said-scrolly-dots"
        data-scrolly-dots
        aria-hidden="true"
      >
      </div>
      <div class="said-scrolly-step" data-scrolly-step>
        <h2>The chapter is a record<span class="dot">.</span></h2>
        <p class="said-note">
          Every chapter reads as one running record, the freshest word on top.
          Each page carries its status, its dates, the files it points at, and
          who spoke last — so catching up after three days away is a scroll, not
          an excavation. No columns to tend; the record keeps itself.
        </p>
        <SaidShot
          src="/said-and-done/shots/dossier-light.png"
          alt="The record — one running account of every page, freshest first"
          caption="Every page as a line in the record — status, dates, files, and voices attached."
          class="said-scrolly-shot"
        />
      </div>
      <div class="said-scrolly-step" data-scrolly-step>
        <h2>A status is a chord<span class="dot">.</span></h2>
        <p class="said-note">
          Backlog, to do, in progress, done — every page wears exactly one. Pick
          a page with the keyboard, change its status with a chord, and the
          strip at the bottom names every live key — nothing to memorise,
          nothing hiding behind a menu.
        </p>
        <SaidShot
          src="/said-and-done/shots/board.png"
          alt="The record mid-decision — pages wearing their statuses"
          caption="A real notebook mid-decision — backlog to done, one chord apart."
          class="said-scrolly-shot"
        />
      </div>
      <div class="said-scrolly-step" data-scrolly-step>
        <h2>
          Any page opens as a case file<span class="dot">.</span>
        </h2>
        <p class="said-note">
          One sheet holds a page's whole life — the body, the referenced
          markdown read in place, every comment, every attachment, and the
          history of who did what, when. Esc closes it, and you are back on the
          record exactly where you left it.
        </p>
        <SaidShot
          src="/said-and-done/shots/casefile.png"
          alt="A case file — one page's whole life on one sheet"
          caption="The case file — body, references, thread, and history on one sheet."
          class="said-scrolly-shot"
        />
      </div>
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">03 · A named teammate</p>
      <h2>A teammate that signs its work<span class="dot">.</span></h2>
      <p class="said-note">
        Your AI agent sits at the same desk through its own door. It files
        pages, resolves them, and speaks in threads — every action signed with
        its own name in the history, exactly the way yours carries yours.
      </p>
      <McpRail
        chips={MCP_ROW_ONE}
        label="MCP clients that work with Said and Done."
      />
      <McpRail
        chips={MCP_ROW_TWO}
        reverse
        label="More MCP clients that work with Said and Done."
      />
      <SaidShot
        src="/said-and-done/shots/casefile.png"
        alt="A case file thread where agent:quartermaster reports, signed by name"
        caption="Signed work — the agent's name in the history, next to yours."
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">04 · Search that understands</p>
      <h2>
        Find what you meant, not just what you typed<span class="dot">.</span>
      </h2>
      <p class="said-note">
        Exact words on one leg, on-device meaning search on the other —
        embeddings computed on your own GPU, sent nowhere. The note that says it
        differently still answers.
      </p>
      <SaidShot
        src="/said-and-done/shots/finder.png"
        alt="The finder — an exact hit on top, meaning-search hits beneath it"
        caption="Exact hits first, meaning matches beneath."
        class="said-reveal said-zoom"
      />
    </div>
  </section>

  <section class="said-frame">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">05 · Yours</p>
      <h2>Yours, on your machine<span class="dot">.</span></h2>
      <p class="said-note">
        One local database. Daily backups you can hold. No account, no cloud, no
        sync service between you and your own plans.
      </p>
      <div class="said-bento">
        <div class="said-bento-tile said-reveal">
          <h3>One folder</h3>
          <p>is the whole setup. Your structure is the structure.</p>
        </div>
        <div class="said-bento-tile said-reveal">
          <h3>Zero clouds</h3>
          <p>Notes stay files. The desk stays local. Nothing phones out.</p>
        </div>
        <div class="said-bento-tile said-reveal">
          <h3>14 days</h3>
          <p>of daily backups — database and attachments, in your folder.</p>
        </div>
        <div class="said-bento-tile said-reveal">
          <h3>Esc closes</h3>
          <p>everything, always. One keyboard rule, no modes, no surprises.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="said-frame said-frame--tile">
    <div class="said-wrap said-reveal">
      <p class="said-kicker">
        06 · <span class="hn-said">Said and</span>{" "}<span class="hn-done"
          >Done.</span
        >
      </p>
      <h2>
        Say it<span class="dot">.</span> Then see it done<span class="dot"
          >.</span
        >
      </h2>
      <p class="said-note">
        <span class="hn-said">Said and</span>{" "}<span class="hn-done"
          >Done.</span
        > is in release-candidate season. The installers — Linux, macOS, Windows,
        everything bundled, nothing to fetch — are almost ready to shake hands.
      </p>
      <div class="said-cta-row">
        <a class="said-btn said-btn-primary" href="/said-and-done/tour/"
          >See every feature</a
        >
        <a class="said-btn said-btn-ghost" href="/said-and-done/blog/"
          >Read the blog</a
        >
      </div>
    </div>
  </section>
  <script src="../../scripts/scrollytell.js"></script>
</SaidLayout>
