---
import "../styles/said.css";
import "../styles/said-shot.css";
import "../styles/said-buttons.css";
import "../styles/said-fx.css";
import SaidNav from "../components/SaidNav.astro";
import SaidFooter from "../components/SaidFooter.astro";
import DevBanner from "../components/DevBanner.astro";

interface Props {
  title: string;
  description: string;
  active?: "tour" | "guides" | "blog" | "download" | "buy";
}

const { title, description, active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href="/said/fonts/MartianMono-Medium-latin.ttf"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href="/said/fonts/JetBrainsMono-Regular-latin.ttf"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href="/said/fonts/JetBrainsMono-Medium-latin.ttf"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/said/icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="said">
    <SaidNav active={active} />
    <slot />
    <SaidFooter />
    <script src="../scripts/said-reveal.js"></script>
    <script src="../scripts/said-hero-shader.js"></script>
    <DevBanner />
  </body>
</html>
