---
import "../styles/said-docs.css";
import "../styles/said-shot.css";
import SaidFooter from "../components/SaidFooter.astro";
import DevBanner from "../components/DevBanner.astro";
import SaidNav from "../components/SaidNav.astro";
import { saidGuides } from "../data/said-guides";

interface Props {
  title: string;
  description: string;
  section: "guides" | "blog";
  kicker: string;
  heading: string;
  dek?: string;
  meta?: string;
  slug?: string;
  progress?: boolean;
  serif?: boolean;
  flavor?: "paper";
  jsonLd?: object;
}

const {
  title,
  description,
  section,
  kicker,
  heading,
  dek,
  meta,
  slug,
  progress = false,
  serif = false,
  flavor,
  jsonLd,
} = Astro.props;
const headText = heading.endsWith(".") ? heading.slice(0, -1) : heading;

const canonical = new URL(Astro.url.pathname, Astro.site);
const sidebar = section === "guides";
const active = slug ? saidGuides.find((g) => g.slug === slug) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href="/said-and-done/fonts/MartianMono-Medium-latin.ttf"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href="/said-and-done/fonts/JetBrainsMono-Regular-latin.ttf"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href="/said-and-done/fonts/JetBrainsMono-Medium-latin.ttf"
      crossorigin
    />
    {
      import.meta.env.DEV ? (
        <link
          rel="icon"
          type="image/svg+xml"
          sizes="any"
          href="/favicon-dev.svg?v=10"
        />
      ) : (
        <>
          <link
            rel="icon"
            type="image/svg+xml"
            sizes="any"
            href="/favicon.svg?v=10"
          />
          <link rel="icon" href="/favicon.ico?v=10" type="image/x-icon" />
          <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png?v=10"
          />
          <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png?v=10"
          />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }
  </head>
  <body
    class:list={[
      "sdoc",
      section === "guides" && "sdoc-guides",
      flavor === "paper" && "sdoc-paper",
    ]}
  >
    {progress && <div class="sdoc-progress" aria-hidden="true" />}
    <SaidNav active={section} />

    <div class:list={["sdoc-shell", !sidebar && "sdoc-shell--noside"]}>
      {
        sidebar && (
          <nav class="sdoc-sidebar" aria-label="Guides">
            <p class="sdoc-sidebar-label">Guides</p>
            <ul>
              <li>
                <a
                  class:list={["sdoc-side-link", !slug && "is-active"]}
                  href="/said-and-done/guides/"
                  aria-current={!slug ? "page" : undefined}
                >
                  All guides
                </a>
              </li>
              {saidGuides.map((g) => (
                <li>
                  <a
                    class:list={[
                      "sdoc-side-link",
                      g.slug === slug && "is-active",
                    ]}
                    href={`/said-and-done/guides/${g.slug}/`}
                    aria-current={g.slug === slug ? "page" : undefined}
                  >
                    {g.title}
                  </a>
                  {g.slug === slug && (
                    <ul class="sdoc-subnav">
                      {g.sections.map((s) => (
                        <li>
                          <a href={`#${s.id}`}>{s.label}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <main class:list={["sdoc-main", serif && "sdoc-article-serif"]}>
        <p class="sdoc-kicker">{kicker}</p>
        <h1>{headText}<span class="sdoc-dot">.</span></h1>
        {dek && <p class="sdoc-dek">{dek}</p>}
        {meta && <p class="sdoc-meta" set:html={meta} />}
        <div class="sdoc-body">
          <slot />
        </div>
        <slot name="after" />
      </main>

      {
        sidebar && active && (
          <aside class="sdoc-toc" aria-label="On this page">
            <p class="sdoc-toc-label">On this page</p>
            <ul>
              {active.sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.label}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <SaidFooter home />

    {progress && <script src="../scripts/said-progress.js" />}
    <DevBanner />
    <script src="../scripts/said-copy.js"></script>
    <script src="../scripts/said-brandmark.js"></script>
  </body>
</html>
