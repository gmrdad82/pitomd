---
// Base layout for pitomd.com — the over-the-top PITO showcase.
//
// <head> (favicons + meta + OG + fonts) and a <body> slot. The fx islands
// (railnav, reveal, pointer, themes) load here, deferred, once per page.

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PITO — one chatbox. every channel.",
  description = "PITO is the best YouTube tool for multi-channel creators: one self-hosted chatbox for every channel. Free, private, open source.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/media/pito-tour-thumb.png", Astro.site);

// Structured data — a free, self-hosted SoftwareApplication (PITO) marketed by
// this site, plus the WebSite node. Helps Google understand + enrich the result.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "pitomd",
      url: Astro.site?.href,
      description,
    },
    {
      "@type": "SoftwareApplication",
      name: "PITO",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Docker (Linux, macOS, Windows)",
      url: Astro.site?.href,
      description,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      license: "https://www.gnu.org/licenses/agpl-3.0",
      author: {
        "@type": "Person",
        name: "Catalin Ilinca",
        url: "https://www.youtube.com/@gmrdad82",
      },
      sameAs: [
        "https://github.com/gmrdad82/pito",
        "https://www.youtube.com/@gmrdad82",
        "https://x.com/GamerDady82",
        "https://discord.gg/q947UyDTqJ",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="tokyo-night">
  <head>
    <meta charset="utf-8" />
    {
      /* JS flag — reveal elements only start hidden when JS can un-hide them. */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="application-name" content="PITO" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />

    {
      /* Webfonts — a varied display palette so each section has its own voice,
        plus JetBrains Mono for the terminal accents. */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/space-grotesk-latin.woff2"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&family=Syne:wght@700;800&family=Unbounded:wght@600;800&display=swap"
    />

    {
      /* Favicon. In DEV we emit ONLY the synthwave-YELLOW SVG — no .ico, no PNGs,
        no manifest — so nothing blue can win the browser's icon race and a
        localhost tab is unmistakably yellow. PRODUCTION gets the full set (the
        inverse blue SVG first, then .ico/.png fallbacks + manifest). */
    }
    {
      import.meta.env.DEV ? (
        <link
          rel="icon"
          type="image/svg+xml"
          sizes="any"
          href="/favicon-dev.svg?v=5"
        />
      ) : (
        <>
          <link
            rel="icon"
            type="image/svg+xml"
            sizes="any"
            href="/favicon.svg?v=5"
          />
          <link rel="icon" href="/favicon.ico?v=5" type="image/x-icon" />
          <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png?v=5"
          />
          <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png?v=5"
          />
          <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png?v=5"
          />
          <link rel="manifest" href="/site.webmanifest" />
          <meta name="msapplication-TileColor" content="#1a1b26" />
          <meta name="msapplication-config" content="/browserconfig.xml" />
        </>
      )
    }

    {/* Open Graph / Twitter */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Structured data (JSON-LD) */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <slot />

    {/* film grain + cursor ring — full-page fx layers (fx.css / cursor.js) */}
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    {
      /* Dev-only banner pinned to the bottom (synthwave yellow), so a localhost
        tab is unmistakable next to production — mirrors pito's DEVELOPMENT bar. */
    }
    {import.meta.env.DEV && <div class="dev-banner">DEVELOPMENT</div>}

    {/* fx islands — deferred, vanilla, dependency-free. */}
    <script src="../scripts/fx-random.js"></script>
    <script src="../scripts/railnav.js"></script>
    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/pointer.js"></script>
    <script src="../scripts/fx-webgl.js"></script>
    <script src="../scripts/parallax.js"></script>
    <script src="../scripts/themes.js"></script>
    <script src="../scripts/scrollytell.js"></script>
    <script src="../scripts/copy.js"></script>
    <script src="../scripts/bridge.js"></script>
    <script src="../scripts/currency.js"></script>
    <script src="../scripts/cursor.js"></script>
  </body>
</html>
