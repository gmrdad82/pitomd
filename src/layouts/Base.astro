---
// Base layout for pitomd.com — the over-the-top PITO showcase.
//
// <head> (favicons + meta + OG + fonts) and a <body> slot. The fx islands
// (railnav, reveal, pointer, themes) load here, deferred, once per page.

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PITO — one chatbox. every channel.",
  description =
    "PITO is the best YouTube tool for multi-channel creators: one self-hosted chatbox for every channel. Free, private, open source.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/media/pito-tour-thumb.png", Astro.site);
---

<!doctype html>
<html lang="en" data-theme="tokyo-night">
  <head>
    <meta charset="utf-8" />
    {/* JS flag — reveal elements only start hidden when JS can un-hide them. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="application-name" content="PITO" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />

    {/* Display + mono webfonts (Space Grotesk / JetBrains Mono). */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />

    {/* Favicons — the apex PITO mark, sourced from the app. */}
    <link rel="icon" href="/favicon.ico?v=2" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#1a1b26" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    {/* Open Graph / Twitter */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <slot />

    {/* fx islands — deferred, vanilla, dependency-free. */}
    <script src="../scripts/railnav.js"></script>
    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/pointer.js"></script>
    <script src="../scripts/themes.js"></script>
  </body>
</html>
