---
// Base layout for pitomd.com — the over-the-top Pito showcase.
//
// <head> (favicons + meta + OG + fonts) and a <body> slot. The fx islands
// (railnav, reveal, pointer, themes) load here, deferred, once per page.

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph / Twitter card image path (site-relative). Every route
   *  passes its own so distinct routes carry distinct social cards. */
  ogImage?: string;
  /** JSON-LD override. Each route describes itself — the default below is
   *  a bare WebSite node for the root teaser; /chat passes its own free
   *  SoftwareApplication graph. */
  jsonLd?: object;
}

// GOAL-1 estate freeze (F4): `/` is now the countdown teaser (the chat
// showcase moved to `/chat`, which passes its own title/description/jsonLd)
// — these defaults describe the teaser, the route that actually uses them.
const {
  title = "pitomd.com",
  description = "Something is counting. Touch it.",
  ogImage: ogImagePath = "/media/pito-tour-thumb.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);

// Bare WebSite node — no product claims, no SoftwareApplication (F4: "no
// product claims about what is coming"). Routes that DO sell something
// (`/chat` today) pass their own richer jsonLd graph via the prop above.
const defaultJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "pitomd",
      url: Astro.site?.href,
      description,
    },
  ],
};

const jsonLd = Astro.props.jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang="en" data-theme="tokyo-night">
  <head>
    <meta charset="utf-8" />
    {
      /* JS flag — reveal elements only start hidden when JS can un-hide them. */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="application-name" content="Pito" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />

    {
      /* Webfonts — a varied display palette so each section has its own voice,
        plus JetBrains Mono for the terminal accents. */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/space-grotesk-latin.woff2"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&family=Syne:wght@700;800&family=Unbounded:wght@600;800&display=swap"
    />

    {
      /* Favicon. In DEV we emit ONLY the synthwave-YELLOW SVG — no .ico, no PNGs,
        no manifest — so nothing blue can win the browser's icon race and a
        localhost tab is unmistakably yellow. PRODUCTION gets the full set (the
        inverse blue SVG first, then .ico/.png fallbacks + manifest). */
    }
    {
      import.meta.env.DEV ? (
        <link
          rel="icon"
          type="image/svg+xml"
          sizes="any"
          href="/favicon-dev.svg?v=8"
        />
      ) : (
        <>
          <link
            rel="icon"
            type="image/svg+xml"
            sizes="any"
            href="/favicon.svg?v=8"
          />
          <link rel="icon" href="/favicon.ico?v=8" type="image/x-icon" />
          <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png?v=8"
          />
          <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png?v=8"
          />
          <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png?v=8"
          />
          <link rel="manifest" href="/site.webmanifest" />
          <meta name="msapplication-TileColor" content="#1a1b26" />
          <meta name="msapplication-config" content="/browserconfig.xml" />
        </>
      )
    }

    {/* Open Graph / Twitter */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Structured data (JSON-LD) */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <slot />

    {/* film grain + cursor ring — full-page fx layers (fx.css / cursor.js) */}
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    {
      /* The "Studio is here!" neon sign (5.0.0) is UNMOUNTED (F4, GOAL 1):
        /studio is parked (src/parked/studio.astro, unrouted) until it
        ships, so nothing on this site points at it right now. The
        component file itself stays — StudioBanner.astro — for when Studio
        actually launches. */
    }

    {
      /* Dev-only banner pinned to the bottom (synthwave yellow), so a localhost
        tab is unmistakable next to production — mirrors pito's DEVELOPMENT bar. */
    }
    {import.meta.env.DEV && <div class="dev-banner">DEVELOPMENT</div>}

    {
      /* fx islands — deferred, vanilla, dependency-free. Since the 5.0.0 fx
        cull there is no runtime randomiser: cursor moods are stamped in the
        markup (stable keys), so the islands only ever READ them. */
    }
    <script src="../scripts/railnav.js"></script>
    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/pointer.js"></script>
    <script src="../scripts/fx-webgl.js"></script>
    <script src="../scripts/parallax.js"></script>
    <script src="../scripts/scrollytell.js"></script>
    <script src="../scripts/copy.js"></script>
    <script src="../scripts/bridge.js"></script>
    <script src="../scripts/currency.js"></script>
    <script src="../scripts/cursor.js"></script>
    <script src="../scripts/cover-slots.js"></script>
    <script src="../scripts/fps.js"></script>
  </body>
</html>
