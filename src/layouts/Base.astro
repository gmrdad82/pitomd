---
// Base layout for pitomd.com — the Pito marketing/landing site.
//
// Bare shell: <head> (favicons + meta) and a <body> slot. Dark-only; the
// page content lives in src/pages/. No theme toggle, no scripts.

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "pito ~ best YouTube tool",
  description = "best YouTube tool",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="application-name" content="pito" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="color-scheme" content="dark" />

    {/* Favicons — the apex Pito mark, sourced from the app. */}
    <link rel="icon" href="/favicon.ico?v=2" type="image/x-icon" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png?v=2"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#1a1b26" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta property="og:title" content="pito" />
    <meta property="og:description" content="best YouTube tool" />
    <meta
      property="og:image"
      content="https://pitomd.com/favicon-256x256.png?v=2"
    />
    <meta property="og:url" content="https://pitomd.com" />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <slot />
  </body>
</html>
