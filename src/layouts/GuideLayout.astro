---
// GuideLayout.astro — the /guides documentation shell (owner restyle
// order, 2026-07-30: "guides must NOT look like the /chat landing... get
// their OWN style domain, like /studio will").
//
// A reader-documentation layout (reference: the Svelte docs site) instead
// of the marketing site's scroll-snapped spectacle: a slim top bar, a
// left sidebar (the four guides +, on a guide page, its own in-page
// section jumps, current page highlighted), a comfortable reading column,
// an optional right-hand "on this page" list on wide screens, and a
// light/dark toggle that persists a visitor's choice and otherwise
// defaults to their system preference (guide-theme.js + the
// `@media (prefers-color-scheme)` block in guide.css). The whole shell
// lives under its own `.guide-app` token scope (--gdoc-*) — see guide.css's
// header comment for why that's deliberate.
//
// The one piece reused verbatim from the rest of the site, per the owner's
// explicit order, is the return pill: the exact same <CrossNav> component
// /chat and `/` already use, fixed top-left, pointing at the site root —
// /studio isn't a live route yet (it's parked, unrouted, until Studio
// ships), so "back to Studio" resolves to `/` today, same as everywhere
// else CrossNav is used to leave a product page.

import Base from "./Base.astro";
import CrossNav from "../components/CrossNav.astro";
import { guides, guideSections } from "../data/guides.js";
import "../styles/guide.css";

interface Props {
  title: string;
  description: string;
  /** small label above the heading, e.g. "Games Library · IGDB" */
  eyebrow: string;
  /** the h1 — keep it short, it also becomes the browser tab's neighbor */
  heading: string;
  /** one-paragraph dek under the heading */
  dek: string;
  /** slug of the guide THIS page is (igdb/youtube/tiktok/claude) — omit on
   *  the /guides docs-home page itself, which shows no "current" guide */
  slug?: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  title,
  description,
  eyebrow,
  heading,
  dek,
  slug,
  ogImage = "/logo/pito-logo-hero.png",
  jsonLd,
} = Astro.props;

const idx = slug ? guides.findIndex((g) => g.slug === slug) : -1;
const prevGuide = idx > 0 ? guides[idx - 1] : null;
const nextGuide = idx > -1 && idx < guides.length - 1 ? guides[idx + 1] : null;
---

<Base title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  {
    /* Applies a SAVED light/dark override before first paint (no flash).
       The system-preference default needs no JS at all — see guide.css. */
  }
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem("pito-guide-theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-guide-theme", saved);
        }
      } catch (e) {
        /* private browsing / storage disabled — system default still applies */
      }
    })();
  </script>

  <CrossNav href="/" label="Pito Studio" position="top-left" variant="seller" />

  <div class="guide-app">
    <a class="guide-skip" href="#guide-main">Skip to guide content</a>

    <header class="guide-topbar">
      <a class="guide-topbar__brand" href="/guides">Guides</a>
      <button
        type="button"
        class="guide-theme-toggle"
        data-guide-theme-toggle
        aria-label="Switch between light and dark"
      >
        <span
          class="guide-theme-toggle__icon"
          data-guide-theme-icon
          aria-hidden="true">☾</span
        >
        <span data-guide-theme-label>Dark</span>
      </button>
    </header>

    <div class="guide-shell">
      <nav class="guide-sidebar" aria-label="Guides">
        <a
          class:list={["guide-sidebar__home", !slug && "is-active"]}
          href="/guides"
          aria-current={!slug ? "page" : undefined}
        >
          Guides home
        </a>
        <p class="guide-sidebar__label">Setup guides</p>
        <ul class="guide-sidebar__list">
          {
            guides.map((g) => (
              <li>
                <a
                  href={`/guides/${g.slug}`}
                  class:list={[
                    "guide-sidebar__link",
                    g.slug === slug && "is-active",
                  ]}
                  aria-current={g.slug === slug ? "page" : undefined}
                >
                  {g.title}
                </a>
                {g.slug === slug && (
                  <ul class="guide-sidebar__subnav">
                    {guideSections.map((s) => (
                      <li>
                        <a href={`#${s.id}`}>{s.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <main id="guide-main" class="guide-main">
        <article class:list={["guide-content", !slug && "guide-content--wide"]}>
          <header>
            <p class="guide-kicker">{eyebrow}</p>
            <h1>{heading}</h1>
            <p class="guide-dek">{dek}</p>
          </header>

          <div class="guide__body">
            <slot />
          </div>

          {
            slug && (prevGuide || nextGuide) && (
              <nav class="guide-pager" aria-label="More guides">
                {prevGuide ? (
                  <a
                    class="guide-pager__link guide-pager__link--prev"
                    href={`/guides/${prevGuide.slug}`}
                  >
                    <span class="guide-pager__dir">Previous</span>
                    <span class="guide-pager__title">{prevGuide.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {nextGuide ? (
                  <a
                    class="guide-pager__link guide-pager__link--next"
                    href={`/guides/${nextGuide.slug}`}
                  >
                    <span class="guide-pager__dir">Next</span>
                    <span class="guide-pager__title">{nextGuide.title}</span>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )
          }
        </article>

        {
          slug && (
            <aside class="guide-toc" aria-label="On this page">
              <p class="guide-toc__label">On this page</p>
              <ul>
                {guideSections.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>{s.label}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </main>
    </div>
  </div>

  <script src="../scripts/guide-theme.js"></script>
</Base>
