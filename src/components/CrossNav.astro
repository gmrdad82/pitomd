---
// CrossNav.astro — the fixed cross-link pill used across pitomd's routes.
//
// A minimal, crawlable <a> (no JS, no canvas text) pinned to a corner.
// Originally the chat<->Studio pill (top-right, H4) — 5.0.0's estate freeze
// (F4) repurposed it for the countdown teaser's `position="bottom-right"`
// banner (/ -> /chat) and /chat's `position="top-left"` banner (/chat -> /),
// so both routes carry a small way back without inventing a second
// component. Default stays "top-right" (the parked /studio page's own
// usage, content preserved as-is).

interface Props {
  /** destination path */
  href: string;
  /** visible label, e.g. "Pito Studio" (no arrows — owner ruling) */
  label: string;
  /** corner to pin to */
  position?: "top-right" | "top-left" | "bottom-right";
  /** "seller" makes the pill a neon come-hither, not a quiet way back
   *  (owner, freeze QA: "this is our seller… it should sell not 'just
   *  be present'"). */
  variant?: "quiet" | "seller";
}

const { href, label, position = "top-right", variant = "quiet" } = Astro.props;
---

<nav
  class={`crossnav crossnav--${position} crossnav--${variant}`}
  aria-label="Pito sites"
>
  <a class="crossnav__link mono" href={href} data-magnetic>{label}</a>
</nav>

<style>
  .crossnav {
    position: fixed;
    z-index: 90; /* above sections, below the dev banner (100) */
  }

  .crossnav--top-right {
    top: 14px;
    right: 16px;
  }

  .crossnav--top-left {
    top: 14px;
    left: 16px;
  }

  .crossnav--bottom-right {
    right: 16px;
    bottom: 16px;
  }

  .crossnav__link {
    /* flex centering (owner: "this is not vertical aligned") — the mono
       glyphs sat high of center in the old inline-block/baseline layout */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0.55em 0.9em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--fg-default, #e6e6f0);
    background: color-mix(
      in oklch,
      var(--bg-elevated, #14142a) 78%,
      transparent
    );
    border: 1px solid var(--border-faded, rgb(255 255 255 / 18%));
    border-radius: 999px;
    backdrop-filter: blur(6px);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .crossnav__link:hover,
  .crossnav__link:focus-visible {
    color: #5170ff; /* pito-blue, constant across all themes */
    border-color: #5170ff;
    background: color-mix(in oklch, var(--bg-elevated, #14142a) 92%, #5170ff);
  }

  /* ── the seller ─────────────────────────────────────────────────────
     Neon, breathing, unmissable — the one pill that sells. Pink →
     purple, the brand's own pair (owner: "a pink/purple/neon style
     background so that's always visible") — near-opaque on purpose: the
     old translucent wash disappeared against busy page art. Two hues,
     never rainbow. */
  .crossnav--seller .crossnav__link {
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.7em 1.25em;
    border: 1px solid #ffb3e2;
    background: linear-gradient(
      120deg,
      rgb(255 110 199 / 92%),
      rgb(187 154 247 / 94%),
      rgb(128 131 251 / 92%)
    );
    box-shadow:
      0 0 14px rgb(255 110 199 / 60%),
      0 0 42px rgb(187 154 247 / 35%),
      inset 0 0 10px rgb(255 255 255 / 18%);
    text-shadow: 0 1px 6px rgb(60 20 80 / 70%);
    animation: crossnav-breathe 2.6s ease-in-out infinite;
  }
  .crossnav--seller .crossnav__link:hover,
  .crossnav--seller .crossnav__link:focus-visible {
    color: #fff;
    border-color: #ffd3ee;
    box-shadow:
      0 0 22px rgb(255 110 199 / 85%),
      0 0 64px rgb(187 154 247 / 50%),
      inset 0 0 12px rgb(255 255 255 / 25%);
  }
  @keyframes crossnav-breathe {
    0%,
    100% {
      box-shadow:
        0 0 14px rgb(255 110 199 / 60%),
        0 0 42px rgb(187 154 247 / 35%),
        inset 0 0 10px rgb(255 255 255 / 18%);
    }
    50% {
      box-shadow:
        0 0 24px rgb(255 110 199 / 90%),
        0 0 60px rgb(187 154 247 / 55%),
        inset 0 0 12px rgb(255 255 255 / 28%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crossnav--seller .crossnav__link {
      animation: none;
    }
  }

  .crossnav__link:focus-visible {
    outline: 2px solid #5170ff;
    outline-offset: 2px;
  }

  @media (max-width: 860px) {
    .crossnav--top-right,
    .crossnav--top-left {
      top: 10px;
    }

    .crossnav--top-right {
      right: 10px;
    }

    .crossnav--top-left {
      left: 10px;
    }

    .crossnav--bottom-right {
      right: 10px;
      bottom: 10px;
    }

    .crossnav__link {
      font-size: 0.72rem;
      padding: 0.4em 0.75em;
    }
  }
</style>
