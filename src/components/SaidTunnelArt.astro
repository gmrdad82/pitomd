---
interface Props {
  provider: string;
  host?: string;
}
const { provider, host = "your-tunnel.example" } = Astro.props;
---

<div class="said-after-art" aria-hidden="true">
  <svg viewBox="0 0 640 200" role="img">
    <defs>
      <marker
        id="tunnel-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--sdoc-blue, #0fa8f0)"></path>
      </marker>
    </defs>
    <rect
      x="24"
      y="52"
      width="150"
      height="96"
      rx="12"
      fill="var(--sdoc-panel, #0e1826)"
      stroke="var(--sdoc-line, rgb(148 225 255 / 14%))"></rect>
    <rect
      x="40"
      y="68"
      width="118"
      height="52"
      rx="6"
      fill="rgb(15 168 240 / 10%)"
      stroke="var(--sdoc-line, rgb(148 225 255 / 14%))"></rect>
    <text
      x="99"
      y="99"
      font-family="var(--said-body)"
      font-size="12"
      fill="var(--sdoc-ink, #eceff4)"
      text-anchor="middle">the desk</text
    >
    <text
      x="99"
      y="138"
      font-family="var(--said-body)"
      font-size="10"
      fill="var(--sdoc-faint, #6c7a96)"
      text-anchor="middle">127.0.0.1:5180</text
    >
    <path
      d="M182 100 h76"
      stroke="var(--sdoc-blue, #0fa8f0)"
      stroke-width="2.5"
      stroke-dasharray="7 7"
      marker-end="url(#tunnel-arrow)"
    >
      <animate
        attributeName="stroke-dashoffset"
        values="14;0"
        dur="1s"
        repeatCount="indefinite"></animate>
    </path>
    <rect
      x="270"
      y="72"
      width="126"
      height="56"
      rx="28"
      fill="rgb(15 168 240 / 14%)"
      stroke="var(--sdoc-blue, #0fa8f0)"></rect>
    <text
      x="333"
      y="97"
      font-family="var(--said-body)"
      font-size="12"
      fill="var(--sdoc-blue, #0fa8f0)"
      text-anchor="middle">{provider}</text
    >
    <text
      x="333"
      y="115"
      font-family="var(--said-body)"
      font-size="9.5"
      fill="var(--sdoc-faint, #6c7a96)"
      text-anchor="middle">your own tunnel</text
    >
    <path
      d="M404 100 h84"
      stroke="var(--sdoc-blue, #0fa8f0)"
      stroke-width="2.5"
      stroke-dasharray="7 7"
      marker-end="url(#tunnel-arrow)"
    >
      <animate
        attributeName="stroke-dashoffset"
        values="14;0"
        dur="1s"
        repeatCount="indefinite"></animate>
    </path>
    <rect
      x="512"
      y="34"
      width="96"
      height="132"
      rx="18"
      fill="var(--sdoc-panel, #0e1826)"
      stroke="var(--sdoc-line, rgb(148 225 255 / 14%))"></rect>
    <rect
      x="522"
      y="48"
      width="76"
      height="104"
      rx="8"
      fill="rgb(148 225 255 / 6%)"></rect>
    <text
      x="560"
      y="96"
      font-family="var(--said-body)"
      font-size="11"
      fill="var(--sdoc-ink, #eceff4)"
      text-anchor="middle">the same</text
    >
    <text
      x="560"
      y="112"
      font-family="var(--said-body)"
      font-size="11"
      fill="var(--sdoc-ink, #eceff4)"
      text-anchor="middle">desk</text
    >
    <text
      x="560"
      y="186"
      font-family="var(--said-body)"
      font-size="9.5"
      fill="var(--sdoc-faint, #6c7a96)"
      text-anchor="middle">{host}</text
    >
  </svg>
</div>
