---
// PitoLogo.astro — the PITO ASCII wordmark, lifted verbatim from pito's
// start-screen partial (app/components/pito/start_screen/component.html.erb).
//
// Block glyphs use the constant brand blue; the box-drawing "shadow" uses the
// theme's dim foreground, so the mark re-themes with its section. Each row is a
// span so fx can stagger them. Theme-reactive and crisp at any size — no PNG.

interface Props {
  /** extra class on the <pre> */
  class?: string;
  /** when true, rows carry data-reveal for a staggered dissolve-in */
  reveal?: boolean;
}
const { class: extra = "", reveal = false } = Astro.props;
const rowAttr = reveal ? { "data-reveal": "rise" } : {};
---

<pre
  class:list={["pito-logo", extra]}
  aria-label="PITO"
  role="img"
  data-stagger>
<span {...rowAttr} style="--i:0"><span class="b">██████</span><span class="s">╗ </span><span class="b">██</span><span class="s">╗</span><span class="b">████████</span><span class="s">╗ </span><span class="b">██████</span><span class="s">╗ </span></span>
<span {...rowAttr} style="--i:1"><span class="b">██</span><span class="s">╔══</span><span class="b">██</span><span class="s">╗</span><span class="b">██</span><span class="s">║╚══</span><span class="b">██</span><span class="s">╔══╝</span><span class="b">██</span><span class="s">╔═══</span><span class="b">██</span><span class="s">╗</span></span>
<span {...rowAttr} style="--i:2"><span class="b">██████</span><span class="s">╔╝</span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║</span></span>
<span {...rowAttr} style="--i:3"><span class="b">██</span><span class="s">╔═══╝ </span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║</span></span>
<span {...rowAttr} style="--i:4"><span class="b">██</span><span class="s">║     </span><span class="b">██</span><span class="s">║   </span><span class="b">██</span><span class="s">║   ╚</span><span class="b">██████</span><span class="s">╔╝</span></span>
<span {...rowAttr} style="--i:5"><span class="s">╚═╝     ╚═╝   ╚═╝    ╚═════╝ </span></span>
</pre>
