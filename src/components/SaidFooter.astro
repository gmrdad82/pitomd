---
interface Props {
  brand?: boolean;
  home?: boolean;
}

const { home = false } = Astro.props;
---

<footer class="said-shared-footer is-minimal">
  {
    home && (
      <a class="foot-home mono" href="/" aria-label="Back to pitomd.com">
        <span>Back to</span>
        <img src="/logo/pito-p.svg" alt="PITO" width="20" height="20" />
      </a>
    )
  }
  <slot />
  <div class="foot-legal">© 2026. All rights reserved.</div>
</footer>

<style>
  .said-shared-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 34px clamp(20px, 5vw, 72px) 44px;
    border-top: 1px solid rgb(148 225 255 / 10%);
  }

  :global(.sdoc) .said-shared-footer {
    border-top-color: var(--sdoc-line);
  }

  .foot-legal {
    font-size: 0.78rem;
    opacity: 0.82;
  }

  .is-minimal {
    justify-content: space-between;
  }

  .foot-home {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 9px 7px 14px;
    border-radius: 999px;
    overflow: hidden;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(
      115deg,
      #ff4d6d 0%,
      #ff2e93 34%,
      #a44dff 66%,
      #0fa8f0 100%
    );
    box-shadow:
      0 8px 24px -8px rgb(255 46 147 / 55%),
      inset 0 1px 0 rgb(255 255 255 / 55%),
      inset 0 -5px 12px rgb(0 0 0 / 25%);
  }

  .foot-home::after {
    content: "";
    position: absolute;
    inset: 2px 2px 52% 2px;
    border-radius: 999px 999px 40% 40%;
    background: linear-gradient(rgb(255 255 255 / 40%), rgb(255 255 255 / 4%));
    pointer-events: none;
  }

  .foot-home:hover {
    filter: brightness(1.08);
  }

  .foot-home img {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 40%));
  }

  .is-minimal .foot-legal {
    margin-left: auto;
  }

  @media (width <= 640px) {
    .said-shared-footer {
      flex-wrap: nowrap;
    }

    .foot-legal {
      margin-left: auto;
      font-size: 0.72rem;
      white-space: nowrap;
    }
  }
</style>
