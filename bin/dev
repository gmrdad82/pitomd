#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if fuser 4321/tcp >/dev/null 2>&1; then
  echo "→ sweeping a stale press off port 4321"
  pkill -f "[p]itomd/node_modules/astro" 2>/dev/null || true
  fuser -k 4321/tcp >/dev/null 2>&1 || true
  sleep 1
fi

if [ ! -d node_modules ]; then
  echo "→ installing dependencies (first run)…"
  npm install
fi

echo "→ pitomd dev server → http://localhost:4321  ·  https://dev.pitomd.com"
exec npm run dev -- --host 127.0.0.1 "$@"
